{
  "name": "@sengoku/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP 境界。認可の適用、DTO とドメインの変換、ユースケースの組み立て",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@sengoku/auth": "workspace:*",
    "@sengoku/config": "workspace:*",
    "@sengoku/contracts": "workspace:*",
    "@sengoku/database": "workspace:*",
    "@sengoku/domain": "workspace:*",
    "@sengoku/integrations": "workspace:*",
    "@sengoku/observability": "workspace:*",
    "@sengoku/validation": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@types/express": "5.0.6",
    "@types/node": "22.20.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
