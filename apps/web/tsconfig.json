{
  "extends": "../../packages/config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
