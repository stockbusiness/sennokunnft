# ============================================================================
# 千ノ国NFTマーケット 環境変数テンプレート
# ----------------------------------------------------------------------------
# このファイルには「変数名」と「説明」のみを記載する。
# 実際の値・サンプル値・ダミー鍵を書いてはならない（CI の check:secrets で検査）。
# 利用手順: cp .env.example .env して値を埋める。.env はコミットされない。
# ============================================================================

# --- 共通 -------------------------------------------------------------------
# 実行モード。node の慣習に従う値: development | test | production
NODE_ENV=
# アプリケーション環境。local | test | staging | production
# production 以外のとき、本番を指す接続先が設定されていると起動を拒否する
APP_ENV=
# ログ出力レベル。trace | debug | info | warn | error | fatal
LOG_LEVEL=

# --- apps/api ---------------------------------------------------------------
# API が待ち受けるポート番号
API_PORT=
# ブラウザから API を参照するときの公開オリジン（CORS 許可リストにも使う）
API_PUBLIC_ORIGIN=
# PostgreSQL 接続文字列。Prisma が使用する
DATABASE_URL=

# --- 認証（Supabase Auth） --------------------------------------------------
# 検証方式は JWKS / ES256 に決定済み（UD-801、2026-08-18）。
# 下の 3 つはいずれも公開情報で、秘密ではない。api は公開鍵しか持たない。
#
# Supabase プロジェクトの URL（例: https://xxxx.supabase.co）
SUPABASE_URL=
# 発行された JWT の iss クレームに期待する値（例: https://xxxx.supabase.co/auth/v1）
SUPABASE_JWT_ISSUER=
# 発行された JWT の aud クレームに期待する値（Supabase の既定は authenticated）
SUPABASE_JWT_AUDIENCE=
# 公開鍵セット（JWKS）の URL
# 例: https://xxxx.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# トークン検証の方式。supabase / dev
# ※ dev は誰でもトークンを作れるため、APP_ENV=production では起動を拒否する
AUTH_PROVIDER=
# 開発用トークンの署名に使うシークレット（8文字以上）。AUTH_PROVIDER=dev のときだけ要る
AUTH_DEV_SECRET=

# 問い合わせでメールアドレスから注文を辿るための鍵（32文字以上）。UD-121
# ※ 平文のメールは保存しない（UD-503）。保存するのはこの鍵で作った照合値だけ
# ※ 未設定なら照合値が付かず、メールからの照合は使えない。既定値は用意しない
# ※ 入れ替えると、それ以前に作られた照合値は引けなくなる
EMAIL_LOOKUP_PEPPER=

# --- 決済 -------------------------------------------------------------------
# 決済プロバイダ識別子。未決定のため既定は fake（UD-702）
PAYMENT_PROVIDER=
# 決済 Webhook の署名検証に使うシークレット
# 緊急上書き（UD-118）。⚠️ 既定は false のまま。
# 管理画面へ入れない場面で決済を復旧するためだけのもの。有効な間は
# 管理画面と起動ログに警告が出る。二重管理が黙って復活するのを避けるため、
# 平時は必ず false にしておくこと。
PAYMENT_EMERGENCY_CREDENTIAL_OVERRIDE=
PAYMENT_WEBHOOK_SECRET=

# --- NFT 発行 ---------------------------------------------------------------
# 発行プロバイダ識別子。ブロックチェーン仕様が未決定のため既定は fake（UD-501）
MINT_PROVIDER=
# 発行ジョブの冪等キーを導出する HMAC シークレット
MINT_IDEMPOTENCY_SECRET=

# --- 受取（Claim） ----------------------------------------------------------
# Claim URL を組み立てるときのベース URL
CLAIM_BASE_URL=

# --- テスト ---------------------------------------------------------------
# 結合テストが使う PostgreSQL の接続文字列。未設定なら結合テストはスキップされる
TEST_DATABASE_URL=
# 1 のとき、TEST_DATABASE_URL 未設定なら結合テストを「スキップ」ではなく「失敗」にする
# CI で設定漏れに気付けるようにするためのもの
REQUIRE_INTEGRATION_TESTS=

# --- apps/worker ------------------------------------------------------------
# 1 回の取得で処理するジョブ件数の上限
WORKER_BATCH_SIZE=
# 常駐モードでのポーリング間隔（ミリ秒）
WORKER_POLL_INTERVAL_MS=

# --- apps/web ---------------------------------------------------------------
# web が API を呼び出すときの内部エンドポイント（サーバー間通信用）
WEB_API_BASE_URL=
# ブラウザへ露出してよい公開サイト名。NEXT_PUBLIC_ 接頭辞の値は秘密にできない
# 空でよい。正式名が未決定（UD-101）のあいだは apps/web/src/site.ts の暫定名を使う
NEXT_PUBLIC_SITE_NAME=
# 運営がAPIを呼ぶときの資格情報。サーバー側でのみ読む
# ⚠️ 1 本しか無く、使うと全員が同じ人として扱われる
#    ログイン機能（下の SUPABASE_*）を設定した環境では使われない
ADMIN_DEV_TOKEN=

# --- ログイン（Supabase Auth・UD-801） --------------------------------------
# ⚠️ 3 つとも設定して初めてログイン機能が有効になる
#    未設定の環境は、従来どおり ADMIN_DEV_TOKEN で動く
# Supabase プロジェクトの URL（例: https://xxxx.supabase.co）
SUPABASE_URL=
# 公開鍵（anon / publishable key）
# ⚠️ service_role キーを入れない。あれは行単位の権限をすべて飛び越える
SUPABASE_ANON_KEY=
# このサイトの入口（例: https://xxxx.vercel.app）。末尾スラッシュなし
# ⚠️ 要求の Host から組み立てない。偽の Host でリンクの行き先を乗っ取られる
WEB_PUBLIC_ORIGIN=
# グループ内テストのための合言葉（UD-102）。8文字以上
# ⚠️ 公開環境（Vercel）で未設定のまま出すと、サイト全体が 503 になる
#    素通しになるより、閉じて気づけるほうを選んでいる
SITE_GATE_PASSWORD=

# --- 画像の保存 -------------------------------------------------------------
# 画像の保存先ディレクトリ。本番ストレージは未決定（UD-508）
MEDIA_STORAGE_DIR=
# 画像の表示URLの前置き。保存するのはキーで、URLは実行時に解決する
MEDIA_PUBLIC_PREFIX=

# --- 共通顧客HUB（代理店システム）連携 -----------------------------------
# 既定は無効。有効にする場合は接続先とAPIキーを必ず設定する
# （揃っていないと起動時に拒否する）。
COMMON_USER_LINKING_ENABLED=
COMMON_USER_API_BASE_URL=
COMMON_USER_API_KEY=
COMMON_USER_SYSTEM_KEY=

# --- Claim API（OVEW Wallet 連携） ---------------------------------------
# 既定は無効。OVEW Wallet 側の署名器が千ノ国共通 HMAC v1.1 FINAL へ揃い、
# 固定テストベクトル（docs/HMAC_TEST_VECTORS.md）が両システムで一致してから
# 有効にする。有効なのに鍵が無ければ起動時に拒否する。
CLAIM_API_ENABLED=
# HMAC の鍵。鍵ID:秘密鍵 をカンマ区切りで並べる。
# 複数書けるのは、鍵の入れ替え中に新旧どちらの署名も受け取れるようにするため。
CLAIM_HMAC_KEYS=
# Claim API のレート制限（1分あたり・鍵IDごと）。GET と POST は別枠。
# ⚠️ GET を実利用より小さくしない。OVEW Wallet の Claim 画面は
# DELIVERY_PENDING のあいだ5秒間隔でポーリングする（1セッション毎分12回）。
# 絞りすぎると攻撃ではなく正規の利用者が弾かれ、症状は
# 「受け取り画面が進まない」で原因に気づきにくい。
CLAIM_RATE_LIMIT_GET_PER_MIN=
CLAIM_RATE_LIMIT_POST_PER_MIN=

# --- 画像の保存先（UD-508: Cloudflare R2） -------------------------------
# local … コンテナの一時領域に書く。⚠️ **再起動で消える。** 開発用のみ
# r2    … Cloudflare R2。本番・staging はこちら
#
# ⚠️ r2 なのに設定が欠けていると起動時に拒否する。
# 起動させると画像のアップロードだけが失敗し、カタログの登録は途中まで
# 進むため「画像の無い作品」ができあがる。表面化するのは Wallet へ
# 配送する段になってから。
MEDIA_STORAGE_PROVIDER=
# local のとき
MEDIA_STORAGE_DIR=
MEDIA_PUBLIC_PREFIX=
# r2 のとき。R2 に割り当てた Custom Domain（例: https://media-stg.example.jp）
#
# ⚠️ **署名付き・期限付きの URL を指定しない。**
# Wallet は受け取った URL を Holding に保存して表示に使うため、期限が切れると
# 過去に渡した分の画像がまとめて壊れる。しかも壊れるのは数日後で気づけない。
# 起動時にも検査しており、期限付きに見える URL は拒否する。
MEDIA_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Wallet Delivery（本システム → OVEW Wallet） -------------------------
# 既定は無効。Claim API とは**別のフラグ**。
# Claim は受け取りの記録まで、配送は Wallet へ届けるところまでを指す。
#
# ⚠️ 有効にすると、受取確定と同時に配送本文が組み立てられる。
# 組み立てられない作品（長期URLの画像が無い等）は**受取そのものが失敗する**。
# 画像の長期URL（Cloudflare R2 + Custom Domain）が整うまで有効にしない。
#
# ⚠️ 有効なのに宛先や鍵が無ければ起動時に拒否する。
# 起動させると受取は成立し続け、配送だけが全件溜まる。
# 利用者の画面は「お届け中」のままなので、誰も異常に気づけない。
WALLET_DELIVERY_ENABLED=
# 送信先。https の完全なURL。平文（http）は起動時に拒否する。
WALLET_DELIVERY_ENDPOINT=
# 千ノ国共通 HMAC v1.1 FINAL の鍵ID。相手が発行する。
WALLET_DELIVERY_KEY_ID=
WALLET_DELIVERY_SECRET=
# 応答を待つ上限（ミリ秒）。待ち続けると配送ワーカーが詰まる。
WALLET_DELIVERY_TIMEOUT_MS=
# 1巡で送る件数の上限（worker）。相手の復旧直後に全件を叩きつけない。
WALLET_DELIVERY_BATCH_SIZE=

# --- 全額返金にともなう取消（M3a） -------------------------------------
# ⚠️ **3本に分けてある。1本にまとめない。** 止めたい対象が3段あるため:
#   1. `claimed → revoked` という業務方針そのもの
#   2. 取消イベントを**作る**か
#   3. 取消イベントを**送る**か
# まとめると、送信だけ止めたい場面で生成まで止まり、
# **止めていた期間の返金が永久に相手へ伝わらなくなる**。
#
# ⚠️ **すべて既定は無効。** `true` の完全一致だけを有効として扱う。
# `1` や `TRUE` は黙って無効に倒さず、**起動を拒否する**。
# 綴り違いで「有効にしたつもりが無効」になる事故を防ぐため。
#
# 受取済み（claimed）も取り消すか（UD-104 追補・2026-08-20 決定）。
# ⚠️ 有効にすると、全額返金で受取済みの受取権も `revoked` へ進む。
#    受取記録（claimed_at / claimed_by / 配送記録）は**残したまま**。
# ⚠️ 本番で有効にした瞬間が、CHECK 制約を単純に戻せなくなる境目。
REFUND_REVOKE_CLAIMED_ENABLED=
# 取消イベントを作るか。
# ⚠️ 日次の補完（reconcile-revocations）も**このフラグに従う**。
#    従わせないと、無効へ戻したのに時計が作り続ける。
WALLET_REVOCATION_EVENT_GENERATION_ENABLED=
# 取消イベントを送るか。
# ⚠️ WALLET_DELIVERY_ENABLED も併せて必要（配送ワーカーの親スイッチ）。
#    こちらだけ有効にしても1件も送られないため、起動時に拒否する。
# ⚠️ 相手が event_version=1.1 と reason_code を受け取れることを
#    契約テストで確かめるまで有効にしない。
WALLET_REVOCATION_EVENT_DELIVERY_ENABLED=

# --- 注文と決済（決済 Phase P0・P1） -------------------------------------
# プラットフォーム手数料率。**bps（1/100 %）の整数**。20% なら 2000。
# ✅ 決定済 2026-08-19（UD-109）: 20%（= 2000）。クリエイター配分は 80%。
#    対象はデジタルアート販売 MVP。グッズは将来、別の体系を設定する。
# ⚠️ **未設定（=0）は「手数料無料」ではなく「販売設定未完了」。**
#    0 のままでは Checkout を作らせない（購入者には「購入準備中」と表示）。
#    「無料で売れてしまう」より「売れない」ほうが取り返しがつく。
# ⚠️ 小数で書かない。率を金額に掛けた瞬間に誤差が入る。
#
# ⚠️ **実行時にはもう読んでいない**（2026-08-19 決定）。正は DB だけで、
#    ここへ黙って落ちることはない。DB と環境変数で違う値が使われる
#    「二重管理」を作らないため。初期値 2000 は一度限りの
#    マイグレーション（20260819110000_platform_fee_rate_seed）で
#    DB へ入れてある。変更は管理画面からオーナーだけが行う。
# ⚠️ 変数の宣言そのものの削除は別 PR（UD-115）。
PLATFORM_FEE_RATE_BPS=
# 在庫のお取り置き時間（分）。既定 30。
ORDER_RESERVATION_MINUTES=
# 内部ジョブ（期限切れ予約の解放）を呼ぶための合言葉。32文字以上。
# ⚠️ 未設定ならその経路は生えない。「設定が無ければ誰でも呼べる」にしない。
# ⚠️ 値そのものをここに書かない。配備環境の設定に入れる。
INTERNAL_JOB_TOKEN=

# --- Stripe（決済 Phase P2） ---------------------------------------------
# ⚠️ **鍵はここ（配備環境の秘密情報管理）にだけ置く**（2026-08-19 決定）。
#    管理画面に鍵の入力欄も再表示も無い。画面に出るのは
#    「設定されているか」「テストか本番か」までで、値は出ない。
#    画面から交換する仕組みは、再認証・二者承認・ローテーション・
#    復旧経路まで揃えた別仕様として扱う（UD-118）。
#
# ⚠️ **戻り先と API 版は管理画面が優先される。** 保存するまでは
#    ここの値が使われる。管理画面から「停止」したときは、ここへは
#    落ちない（止める操作が効かないのがいちばん困るため）。
# 決済事業者。`fake` は手元用の擬似実装（署名の手順は本物と同じ）。
# ⚠️ 既定は fake。既定を stripe にすると、鍵を入れていない環境が
#    「決済できるつもり」で起動する。
PAYMENT_PROVIDER=
# 擬似実装の署名に使う秘密（PAYMENT_PROVIDER=fake のとき）。
PAYMENT_WEBHOOK_SECRET=
# Stripe の秘密鍵。`sk_test_` か `sk_live_` で始まる。
# ⚠️ **値をここに書かない。** 配備環境の設定に入れる。
# ⚠️ 取り違えは起動時に拒否する。production で test 鍵、
#    staging で live 鍵は起動しない（後者は本物のお金が動くため）。
STRIPE_SECRET_KEY=
# Webhook の署名検証に使う秘密。`whsec_` で始まる。
# ⚠️ 無いまま起動しない。署名を確かめずに受けると、
#    誰でも「決済成功」を送れる。
STRIPE_WEBHOOK_SECRET=
# 固定する Stripe API バージョン。既定は SDK が固定している版。
# ⚠️ 上げるのは、変更点を読んでテストを通してから。
STRIPE_API_VERSION=
# 支払い後の戻り先。`{ORDER_ID}` を注文IDへ置き換える。
# ⚠️ 戻り先に秘密を含めない。⚠️ 戻ったことを決済完了の根拠にしない。
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# --- staging Fixture（動作確認用の受取権を作る） -------------------------
# ⚠️ これだけでは足りない。`NODE_ENV != production` と**両方**を満たした
# ときにのみ実行できる。フラグ1本にすると、本番の環境変数へ1行足しただけで
# 本番DBに偽の受取権が作れてしまう。
#
#   pnpm staging:create-test-entitlement --account-id=<uuid> --artwork-id=<uuid>
ENABLE_STAGING_FIXTURES=

# --- 外部連携の資格情報を包む暗号鍵（管理画面・外部連携 指示書 §6.2）---
#
# 形式は `version:base64鍵,version:base64鍵`。鍵は 32 バイト。
# 作り方: openssl rand -base64 32
#
# ⚠️ DB へ置かない。配備環境の Secret（fly secrets）へ置く。
# ⚠️ 消さない。消すと、包んだ資格情報を二度と開けない。その場合は
#    外部サービス側で新しい資格情報を発行し直すことになる。
# ⚠️ api と worker の両方へ同じ値を設定する。worker は管理画面で設定した
#    接続先と鍵を送信のたびに読む。worker に無ければ DB を見ず、
#    下の WALLET_DELIVERY_* だけで動く。
INTEGRATION_ENCRYPTION_KEYS=
# 新しく包むときに使う version。既定は v1。
INTEGRATION_ENCRYPTION_ACTIVE_VERSION=

# --- 購入者への知らせ（P0-4） ---------------------------------------------
# ⚠️ **生成と配送を別のフラグにしてある。** まとめると、送信だけ止めたい
#    場面で生成まで止まり、止めていたあいだの注文が永久に知らされなくなる。
#
# ⚠️ `"true"` の完全一致だけが有効。`"1"` や `"TRUE"` は**黙って無効へ
#    倒さず起動を拒否する**。綴り違いで「有効にしたつもりが無効」を防ぐ。
#
# 知らせを**作る**か。既定は無効。
NOTIFICATION_GENERATION_ENABLED=
# 知らせを**送る**か。既定は無効。
# ⚠️ 有効にするには下の 4 つがそろっている必要がある。欠けていれば起動を拒否する。
# ⚠️ 生成が無効なのに送信だけ有効、という組み合わせも起動を拒否する
#    （1 通も積まれないので、設定した人は「有効にした」と思ったまま気づけない）。
NOTIFICATION_DELIVERY_ENABLED=
# メールの送信事業者。`none`（既定・送らない）か `resend`。
MAIL_PROVIDER=
# ⚠️ 値をリポジトリへ入れない。ログ・画面・API・監査ログへも出さない。
RESEND_API_KEY=
# 差出人。`名前 <address>` の形も使える。
MAIL_FROM_ADDRESS=
# 返信先。未設定なら差出人へ返る。
MAIL_REPLY_TO=
# 宛先を取り出すための鍵（UD-503 決定 2026-08-20）。
# ⚠️ **全利用者を読める強い鍵。** この用途以外へ配らない。
#    ⚠️ 画面側（apps/web）へ渡さない。⚠️ ログへ出さない。
# 本システムは購入者のメールアドレスを平文で持たないため、送信の瞬間だけ
# 認証基盤から取り出して使い、送り終えたら捨てる。
SUPABASE_SERVICE_ROLE_KEY=
# 文面へ差し込む事業者名。
NOTIFICATION_SITE_NAME=
# 文面の中のリンクの起点。
# ⚠️ **誤ると知らせの中のリンクが全部おかしくなる。** 送ったあとに気づいても、
#    届いたメールは直せない。配備ごとに必ず設定する。
NOTIFICATION_SITE_URL=
