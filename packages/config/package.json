{
  "name": "@sengoku/config",
  "version": "0.1.0",
  "private": true,
  "description": "環境変数の型検証と、リポジトリ共通のビルド設定（TypeScript / ESLint / Prettier）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.react.json",
    "eslint.base.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
