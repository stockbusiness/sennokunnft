// 千ノ国NFTマーケット — データベーススキーマ
//
// 設計の根拠は docs/DATABASE_DESIGN.md を参照。
//
// ⚠️ Phase 1 では **スキーマ定義と Prisma Client の生成のみ**を行う。
//    マイグレーションの生成・適用は行わない（本番DBへ接続しない）。
//
// この設計で最も重要なのは、冪等性を「アプリの if 文」ではなく
// **DB の一意制約と条件付き UPDATE** で担保している点。
// 競合状態ではアプリのチェックは破れるが、DB の制約は破れない。

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// アカウント
// ============================================================================

enum AccountRole {
  buyer
  operator
  auditor
}

enum AccountStatus {
  active
  suspended
}

/// 認証の正は Supabase Auth 側にあり、本テーブルは参照と業務属性のみを持つ。
/// パスワードや資格情報は一切保持しない。
model Account {
  id             String        @id @default(uuid()) @db.Uuid
  authProvider   String        @map("auth_provider")
  authSubject    String        @map("auth_subject")
  /// 照合用のハッシュ。平文のメールアドレスは保持しない（UD-503）。
  /// 照合用のメールハッシュ。⚠️ 平文は持たない（`UD-503`）。
  /// ⚠️ 素のハッシュではなく鍵付き（`EMAIL_LOOKUP_PEPPER`）。理由は
  /// ドメインの `EmailHashPort` を参照。
  /// ⚠️ 索引は**部分索引**なので、Prisma では表せない。
  /// `20260820090000_order_support` の手書きマイグレーションにある。
  emailHash      String?       @map("email_hash")
  displayName    String?       @map("display_name")
  /// 重複判定の鍵（決定 2026-08-20）。⚠️ **生成はアプリ側**（domain の
  /// `displayNameKey`）。PostgreSQL の `lower()` は NFKC 正規化をしないので、
  /// DB の関数で作るとアプリ側と結果がずれる。
  /// ⚠️ 部分 UNIQUE 索引 `accounts_display_name_key_unique`
  /// （`WHERE display_name_key IS NOT NULL`）が重複を止める。Prisma では
  /// 条件付き索引を書けないため、**手書きのマイグレーション側にだけ存在する**。
  displayNameKey String?       @map("display_name_key")
  /// ロールの正は本テーブル。JWT のクレームからは読まない（権限昇格を防ぐ）。
  role           AccountRole   @default(buyer)
  status         AccountStatus @default(active)
  /// 人に権限を配れるか（UD-803 決定 2026-08-18）。
  /// ⚠️ 役割とは別の軸。役割は「作品や注文に何ができるか」、
  /// こちらは「人事を触れるか」。4 つ目の役割にすると、operator に許した
  /// 操作をすべて写す必要が生まれ、写し忘れが静かに残る。
  /// ⚠️ CHECK で operator に限っている（accounts_owner_is_operator）。
  isOwner        Boolean       @default(false) @map("is_owner")
  /// 運営スタッフの業務用アドレス。**購入者の行には入らない**（CHECK で縛る）。
  /// ⚠️ UD-503（購入者のメールを平文で持たない）は維持したまま、
  /// オーナーが自分で入力したスタッフの連絡先だけを持つ。
  staffEmail     String?       @map("staff_email")
  /// 二要素で入った最後の時刻（`UD-801` の段階導入 段 1・P0-7 の 8 番目）。
  ///
  /// ⚠️ **「入ったことがある」であって、いまの設定ではない。** 相手側の
  /// 設定を毎回問い合わせるのではなく、二要素で入った記録を根拠にする。
  /// 外したことはこちらからは分からない——だから判定の側で期限を切る。
  ///
  /// ⚠️ **この列だけでは誰も拒否しない**（段 1）。拒否を入れるのは、
  /// オーナーが登録を済ませたあと。順序を飛ばすと、オーナーが自分の
  /// 管理画面から締め出される。
  lastAal2At     DateTime?     @map("last_aal2_at") @db.Timestamptz(6)

  /// 共通顧客ID。**発行元は代理店システムのみ**で、本システムは受け取るだけ。
  /// ⚠️ 主キーにしない。外部が発行した値を主キーにすると、
  /// 相手の都合で自分のデータが壊れる。人物識別は accounts.id のまま。
  /// ⚠️ UNIQUE にしない。同一人物が別の認証手段で 2 アカウントを持つと、
  /// どちらも同じ common_user_id へ解決されうる。UNIQUE にすると
  /// 「正しい解決」が保存できずに落ちる。
  commonUserId            String?   @map("common_user_id")
  commonUserStatus        String    @default("UNRESOLVED") @map("common_user_status")
  commonUserLinkedAt      DateTime? @map("common_user_linked_at") @db.Timestamptz(6)
  /// 失敗の理由。⚠️ 応答本文をそのまま入れない（個人情報が混ざりうる）。
  commonUserLastError     String?   @map("common_user_last_error")
  /// 再試行の状態。指示書は 4 列だが、バックオフには回数と次回時刻が要る。
  commonUserAttemptCount  Int       @default(0) @map("common_user_attempt_count")
  commonUserNextAttemptAt DateTime? @map("common_user_next_attempt_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders                       Order[]
  /// 自分が出品者として受けた注文（1 注文 1 クリエイター）。
  createdOrders                Order[]                      @relation("OrderCreator")
  createdOrderLines            OrderLine[]                  @relation("OrderLineCreator")
  /// 自分が書いた対応メモ（`UD-121`）。⚠️ 消せない。
  orderNotes                   OrderNote[]                  @relation("OrderNoteAuthor")
  entitlements                 Entitlement[]                @relation("EntitlementPurchaser")
  claimedEntitlements          Entitlement[]                @relation("EntitlementClaimer")
  auditLogs                    AuditLog[]
  idempotencyKeys              IdempotencyKey[]
  createdArtworks              Artwork[]                    @relation("ArtworkCreator")
  sentInvitations              StaffInvitation[]            @relation("StaffInvitationInviter")
  acceptedInvitations          StaffInvitation[]            @relation("StaffInvitationAcceptor")
  integrationSettings          IntegrationSetting[]         @relation("IntegrationSettingEditor")
  integrationSecrets           IntegrationSecret[]          @relation("IntegrationSecretCreator")
  integrationChecks            IntegrationConnectionCheck[] @relation("IntegrationCheckExecutor")
  createdLegalVersions         LegalDocumentVersion[]       @relation("LegalVersionAuthor")
  publishedLegalVersions       LegalDocumentVersion[]       @relation("LegalVersionPublisher")
  legalConsents                LegalConsent[]
  registeredPaymentCredentials PaymentCredential[]          @relation("PaymentCredentialRegistrar")
  activatedPaymentCredentials  PaymentCredential[]          @relation("PaymentCredentialActivator")
  settlementSettings           SettlementSettings[]         @relation("SettlementSettingsEditor")
  refunds                      Refund[]                     @relation("RefundActor")
  payouts                      Payout[]                     @relation("PayoutCreator")
  paidPayouts                  Payout[]                     @relation("PayoutPayer")
  resolvedOperationsReviews    OperationsReview[]           @relation("OperationsReviewResolver")
  productionAttestations       ProductionAttestation[]      @relation("ProductionAttester")
  creatorProfile               CreatorProfile?
  accountNotes                 AccountNote[]                @relation("AccountNoteSubject")
  authoredAccountNotes         AccountNote[]                @relation("AccountNoteAuthor")
  emailChangeRequests          EmailChangeRequest[]         @relation("EmailChangeSubject")
  /// お振込先（P1-3）。⚠️ 1 人につき 1 件。
  payoutAccount                CreatorPayoutAccount?        @relation("CreatorPayoutAccount")
  // 返金の申請と審査（方針整理 2026-08-22）。
  requestedRefundRequests      RefundRequest[]              @relation("RefundRequestRequester")
  reviewedRefundRequests       RefundRequest[]              @relation("RefundRequestReviewer")
  approvedRefundRequests       RefundRequest[]              @relation("RefundRequestApprover")
  refundRequestEvents          RefundRequestEvent[]         @relation("RefundRequestEventActor")
  refundInquiries              CreatorRefundInquiry[]       @relation("CreatorRefundInquiry")
  receivables                  CreatorReceivable[]          @relation("CreatorReceivable")
  settledReceivables           CreatorReceivable[]          @relation("CreatorReceivableSettler")
  openedEmailChanges           EmailChangeRequest[]         @relation("EmailChangeOpener")
  verifiedEmailChanges         EmailChangeRequest[]         @relation("EmailChangeVerifier")
  settledEmailChanges          EmailChangeRequest[]         @relation("EmailChangeSettler")
  notifications                NotificationDelivery[]       @relation("NotificationRecipient")

  @@unique([authProvider, authSubject])
  @@index([commonUserStatus, commonUserNextAttemptAt])
  @@index([commonUserId])
  @@map("accounts")
}

/// スタッフの招待（UD-803 決定 2026-08-18）。
///
/// ⚠️ **招待リンクのトークンを持たない。** 受諾は「そのアドレスで
/// ログインできたこと」で判定する。トークンを配ると、転送・流出した
/// リンクを拾った別人が権限を得られる。受信箱に届く経路そのものを
/// 本人確認に使い、鍵を増やさない。
model StaffInvitation {
  id                  String      @id @default(uuid()) @db.Uuid
  /// 招待した宛先。オーナーが自分で入力した値をそのまま残す。
  email               String
  /// 受諾したときに付く役割。buyer は CHECK で弾く。
  role                AccountRole
  /// pending / accepted / revoked / expired
  status              String      @default("pending")
  invitedByAccountId  String      @map("invited_by_account_id") @db.Uuid
  acceptedByAccountId String?     @map("accepted_by_account_id") @db.Uuid
  expiresAt           DateTime    @map("expires_at") @db.Timestamptz(6)
  acceptedAt          DateTime?   @map("accepted_at") @db.Timestamptz(6)
  /// 取り消し・期限切れで閉じた時刻。
  closedAt            DateTime?   @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy  Account  @relation("StaffInvitationInviter", fields: [invitedByAccountId], references: [id])
  /// ⚠️ 受けた人のアカウントは、招待が残っているあいだ消せない（Restrict）。
  /// SetNull にすると「誰かが受けたが、誰かは分からない」行が残る。
  acceptedBy Account? @relation("StaffInvitationAcceptor", fields: [acceptedByAccountId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([invitedByAccountId, createdAt])
  @@map("staff_invitations")
}

/// 外部連携の公開してよい設定（指示書 §5）。
///
/// ⚠️ **秘密の列を作らない。** CHECK では「秘密が入っていないこと」を
/// 表現できない。列そのものを用意しないことでしか担保できない。
model IntegrationSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  /// ovew_wallet / payment / storage / auth
  service            String
  /// staging / production。⚠️ `APP_ENV` とは別物（どの環境向けの設定か）。
  environment        String
  endpointUrl        String?  @map("endpoint_url")
  /// 署名に使う鍵の識別子。⚠️ **秘密ではない。** 鍵そのものは
  /// `integration_secrets` に暗号化して置く。ここに置くのは
  /// 「どの鍵か」を相手へ伝える名前で、署名ヘッダにそのまま載る値。
  keyId              String?  @map("key_id")
  apiVersion         String?  @map("api_version")
  /// 決済にだけ意味のある欄。支払い完了・中止で購入者を戻す先。
  /// ⚠️ 成功URLには `{ORDER_ID}` を含める（どの注文の結果か画面が判断できない）。
  checkoutSuccessUrl String?  @map("checkout_success_url")
  checkoutCancelUrl  String?  @map("checkout_cancel_url")
  /// プラットフォーム手数料（ベーシスポイント）。
  /// ⚠️ **0 は「無料」ではなく「販売設定が未完了」。** 0 のままでは
  /// 支払い口を作らせない。「無料で売れる」より「売れない」ほうが
  /// 取り返しがつくため。
  platformFeeRateBps Int      @default(0) @map("platform_fee_rate_bps")
  timeoutMs          Int      @default(10000) @map("timeout_ms")
  maxAttempts        Int      @default(5) @map("max_attempts")
  enabled            Boolean  @default(false)
  /// 楽観ロック。古い画面からの上書きを弾く（指示書 §12）。
  rowVersion         Int      @default(1) @map("row_version")
  updatedByAccountId String?  @map("updated_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy Account? @relation("IntegrationSettingEditor", fields: [updatedByAccountId], references: [id], onDelete: Restrict)

  @@unique([service, environment])
  @@map("integration_settings")
}

/// 暗号化した資格情報（指示書 §6）。
///
/// ⚠️ **平文を戻す経路を作らない。** 復号してよいのは送信アダプタだけで、
/// 一覧や詳細から呼べる形にしない。
model IntegrationSecret {
  id                 String    @id @default(uuid()) @db.Uuid
  service            String
  environment        String
  /// 同じサービスで複数持てるようにする（鍵ID と 署名鍵 など）。
  purpose            String
  ciphertext         String
  nonce              String
  authTag            String    @map("auth_tag")
  /// どの暗号鍵で包んだか。鍵の交換に備えて必ず持つ。
  keyVersion         String    @map("key_version")
  /// 画面での見分け用。⚠️ **平文の一部**。DB 側で 4 文字に縛ってある。
  lastFour           String    @default("") @map("last_four")
  /// pending / active / retired
  status             String    @default("pending")
  createdByAccountId String?   @map("created_by_account_id") @db.Uuid
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy Account?                     @relation("IntegrationSecretCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  checks    IntegrationConnectionCheck[]

  @@index([service, environment, status])
  @@map("integration_secrets")
}

/// 接続テストの記録（指示書 §9）。
///
/// ⚠️ **外部の生の応答本文を入れない。** 秘匿値が混ざりうる。
/// 残すのは分類コードだけ。
model IntegrationConnectionCheck {
  id                  String   @id @default(uuid()) @db.Uuid
  service             String
  environment         String
  /// 何を確かめたか。いまは到達性のみ（`reachability`）。
  /// ⚠️ 資格情報が正しいかどうかは、この確認では分からない（要決定 06）。
  kind                String
  succeeded           Boolean
  failureCode         String?  @map("failure_code")
  /// 相手が返した HTTP の状態コード。⚠️ 応答本文は保存しない。
  httpStatus          Int?     @map("http_status")
  durationMs          Int      @map("duration_ms")
  secretId            String?  @map("secret_id") @db.Uuid
  executedByAccountId String?  @map("executed_by_account_id") @db.Uuid
  correlationId       String?  @map("correlation_id")
  executedAt          DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)

  secret     IntegrationSecret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  executedBy Account?           @relation("IntegrationCheckExecutor", fields: [executedByAccountId], references: [id], onDelete: Restrict)

  @@index([service, environment, executedAt(sort: Desc)])
  @@map("integration_connection_checks")
}

/// 法務文書の版（利用規約・プライバシーポリシー・特商法表記）。
///
/// ⚠️ **公開した版を書き換えない。** 直すときは新しい版を足す。
/// 「その注文の時点でどう書いてあったか」を示せなくなるため。
/// 書き換えの口はリポジトリにも置かず、UPDATE は `status = 'draft'` の
/// 行だけに効かせる。
///
/// ⚠️ **削除しない。** 消せる口を作ると、いつか「古いから」と消される。
/// 困るのは消したあとに問い合わせが来たときで、そのときには戻せない。
///
/// ⚠️ 下記の索引は Prisma では表せないため、マイグレーションが正:
///   - `legal_document_versions_one_draft_per_kind`（種類ごとに下書き 1 つ）
///   - `legal_document_versions_effective_from_key`（施行日の重複禁止）
model LegalDocumentVersion {
  id                   String    @id @default(uuid()) @db.Uuid
  /// terms / privacy / tokushoho
  kind                 String
  /// 種類ごとの連番。⚠️ 表全体の通し番号にしない。
  version              Int
  /// draft / published。
  /// ⚠️ **「施行中」を持たない。** 施行中かどうかは施行日と現在時刻で
  /// 決まる。状態にすると、日付が来ても誰かが切り替えるまで変わらない。
  status               String    @default("draft")
  title                String
  /// 規約・プライバシーポリシーの本文。⚠️ HTML は保存の時点で断る。
  bodyText             String?   @map("body_text")
  /// 特商法の 12 項目。⚠️ 自由文にしない（欠けを機械が見つけられない）。
  tokushoho            Json?
  /// 施行日。⚠️ 未来の日付を入れられる（公開の予約）。
  effectiveFrom        DateTime? @map("effective_from") @db.Timestamptz(6)
  /// この版から、利用者へもう一度同意を求めるか（`UD-126`）。
  /// ⚠️ **システムに判定させない。** 誤字の修正で全員を止めると、
  /// 同意の画面が「とりあえず押すもの」になる。公開する人が決める。
  /// ⚠️ 下書きには立たない（CHECK で縛る）。
  requiresReconsent    Boolean   @default(false) @map("requires_reconsent")
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  /// 改定の知らせを積み終えた時刻（`UD-127`）。
  /// ⚠️ **公開は取り消せない。** 積むのは公開のあとなので、そのあいだに
  /// 落ちると誰にも届かない。掃き寄せ（cron）が拾い直せるよう、
  /// 「積み終えたか」を版そのものに持たせる。
  /// ⚠️ 途中で落ちても印は立たない。積み直しは安全（積む側の UNIQUE が弾く）。
  /// ⚠️ 掃き寄せ用の**部分索引**は Prisma では表せない。手書きの
  /// マイグレーション `20260821220000_legal_revision_notice` にある。
  noticesEnqueuedAt    DateTime? @map("notices_enqueued_at") @db.Timestamptz(6)
  createdByAccountId   String    @map("created_by_account_id") @db.Uuid
  publishedByAccountId String?   @map("published_by_account_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy   Account        @relation("LegalVersionAuthor", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  publishedBy Account?       @relation("LegalVersionPublisher", fields: [publishedByAccountId], references: [id], onDelete: Restrict)
  consents    LegalConsent[]
  orders      Order[]        @relation("OrderTermsVersion")

  @@unique([kind, version])
  @@index([kind, createdAt(sort: Desc)])
  @@map("legal_document_versions")
}

/// 規約への同意（`UD-126` 決定 2026-08-19）。
///
/// ⚠️ **同意を求めるのは利用規約だけ**（CHECK で縛る）。プライバシー
/// ポリシーを同じチェックへ束ねない。個人情報保護法では利用目的は原則
/// 「公表」で足り、「同意」が要るのは第三者提供などの場面。束ねると、
/// 必要な同意が取れていないのに取れたつもりになる。
///
/// ⚠️ **書き換えも削除もしない。** 同意は起きた出来事で、あとから
/// 無かったことにはできない。
model LegalConsent {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  /// `terms` / `privacy` / `tokushoho` / `creator_terms`。
  /// ⚠️ `creator_terms` は売る人向けの販売規約（P1-2）。買う人向けとは
  /// 同意すべき内容も時点も違うので、種別を分けてある。
  kind        String
  /// どの版に同意したか。⚠️ 真偽値にしない。
  versionId   String   @map("version_id") @db.Uuid
  /// 比較に使う番号。⚠️ ID は順序を持たないので別に持つ。
  version     Int
  consentedAt DateTime @default(now()) @map("consented_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account         Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  documentVersion LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  /// 同じ版へ二重に押しても増やさない。
  @@unique([accountId, versionId])
  /// 「その文書の、古い版に同意した人」を引く（`UD-127`）。
  /// ⚠️ `version` まで入れる。種別だけだと、改定のたびに同意の全行を読む。
  @@index([kind, version, accountId], map: "legal_consents_kind_version_account_idx")
  @@index([accountId, kind, version(sort: Desc)])
  @@map("legal_consents")
}

/// 決済資格情報の世代（`UD-118`・`docs/PAYMENT_CREDENTIAL_ROTATION.md`）。
///
/// ⚠️ **運営会社が変わっても過去の注文を返金できるようにするための表。**
/// 決済事業者側の識別子はアカウントに紐づくので、鍵を上書きすると
/// 過去の注文が返金不能になる。だから世代で持つ。
///
/// ⚠️ **削除しない。** 消すと、その世代で処理した決済の返金経路が消える。
/// `payments.credential_id` は `onDelete: Restrict` で縛ってある。
///
/// ⚠️ 下記の索引は Prisma では表せないため、マイグレーションが正:
///   - `payment_credentials_one_accepting`（新規受付は常に 1 世代）
model PaymentCredential {
  id                      String    @id @default(uuid()) @db.Uuid
  provider                String
  /// staging / production
  environment             String
  /// 1 から始まる連番。⚠️ (provider, environment) ごとに一意。
  generation              Int
  /// 決済事業者側のアカウント識別子（acct_…）。⚠️ **秘密ではない。** 画面に出す。
  accountRef              String?   @map("account_ref")
  /// 運営が付ける覚え書き。⚠️ 秘密を書かせない。
  label                   String?
  /// pending / active / retired
  status                  String    @default("pending")
  secretKeyCiphertext     String    @map("secret_key_ciphertext")
  secretKeyNonce          String    @map("secret_key_nonce")
  secretKeyAuthTag        String    @map("secret_key_auth_tag")
  webhookSecretCiphertext String    @map("webhook_secret_ciphertext")
  webhookSecretNonce      String    @map("webhook_secret_nonce")
  webhookSecretAuthTag    String    @map("webhook_secret_auth_tag")
  keyVersion              String    @map("key_version")
  apiVersion              String?   @map("api_version")
  /// 直近の接続確認。⚠️ **成功していないと有効化できない**（CHECK で縛る）。
  lastCheckSucceeded      Boolean?  @map("last_check_succeeded")
  lastCheckAt             DateTime? @map("last_check_at") @db.Timestamptz(6)
  lastWebhookReceivedAt   DateTime? @map("last_webhook_received_at") @db.Timestamptz(6)
  registeredByAccountId   String    @map("registered_by_account_id") @db.Uuid
  activatedByAccountId    String?   @map("activated_by_account_id") @db.Uuid
  /// active でも新規受付だけ止められる。⚠️ 返金と照会は続く。
  acceptsNewPayments      Boolean   @default(false) @map("accepts_new_payments")
  activatedAt             DateTime? @map("activated_at") @db.Timestamptz(6)
  retiredAt               DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  registeredBy  Account                 @relation("PaymentCredentialRegistrar", fields: [registeredByAccountId], references: [id], onDelete: Restrict)
  activatedBy   Account?                @relation("PaymentCredentialActivator", fields: [activatedByAccountId], references: [id], onDelete: Restrict)
  payments      Payment[]
  webhookEvents WebhookEvent[]
  attestations  ProductionAttestation[]

  @@unique([provider, environment, generation])
  @@index([provider, environment, status, generation(sort: Desc)])
  @@map("payment_credentials")
}

/// 人が残す証跡（実運営 指示書 P0-7）。
///
/// 10 条件のうち 8 つは機械が確かめられる。残る 2 つ——通し試験が通ったことと、
/// 責任者が承認したこと——は、機械には確かめようがない。
///
/// ⚠️ **これは「試験が通った証明」ではない。** 押した人が「通した」と言って
/// いる記録にすぎない。だからこそ誰がいつ押したかを残し、書き換えられない
/// ようにする。
///
/// ⚠️ **追記のみ。** 更新・削除はトリガーが拒む
/// （`production_attestations_append_only`）。アプリ側にも口を作らない。
/// 訂正は新しい記録を足して表す。
model ProductionAttestation {
  id                  String   @id @default(uuid()) @db.Uuid
  /// e2e_sale_test / owner_approval
  kind                String
  /// staging / production。⚠️ 環境をまたいで証拠を使い回させない。
  environment         String
  succeeded           Boolean
  /// ⚠️ **どの決済世代についての記録か。** 紐づけないと、前の鍵で通した
  /// 試験が新しい鍵の証拠として残り続ける。
  credentialId        String   @map("credential_id") @db.Uuid
  attestedByAccountId String   @map("attested_by_account_id") @db.Uuid
  /// ⚠️ 秘密を書かせない。画面にも注意書きを出す。
  note                String?
  attestedAt          DateTime @default(now()) @map("attested_at") @db.Timestamptz(6)

  credential PaymentCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  attestedBy Account           @relation("ProductionAttester", fields: [attestedByAccountId], references: [id], onDelete: Restrict)

  @@index([kind, environment, attestedAt(sort: Desc)])
  @@map("production_attestations")
}

// ============================================================================
// 作品と出品
// ============================================================================

enum ArtworkStatus {
  draft
  published
  archived
}

/// 在庫（発行上限）の正。
/// reservedCount + issuedCount <= maxSupply を DB の CHECK 制約で担保する。
/// アプリ側の行ロック検証と二重に持つことで、バグがあってもオーバーセルさせない。
/// CHECK 制約は Prisma のスキーマ言語で表現できないため、
/// マイグレーション生成時に手書きで追加する（DATABASE_DESIGN.md §3.2）。
model Artwork {
  id               String        @id @default(uuid()) @db.Uuid
  /// 登録した人（UD-102 決定変更 2026-08-18: 作家の自己出品を行う）。
  /// ⚠️ NULL を許さない。持ち主の決まらない作品を作ると、誰が触ってよいかを
  /// 判定できない行が生まれる。判定できない行は「とりあえず通す」に倒れやすい。
  /// ⚠️ ON DELETE を CASCADE にしない。アカウントを消したときに、
  /// 売れた作品まで消えると注文の履歴と食い違う。Restrict にして、
  /// 「作品を持ったままのアカウントは消せない」を DB に守らせる。
  creatorAccountId String        @map("creator_account_id") @db.Uuid
  creator          Account       @relation("ArtworkCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  slug             String        @unique
  title            String
  description      String        @default("")
  /// ストレージ上のキー。公開URLは実行時に解決する（保存先は Cloudflare R2、UD-508）。
  /// アップロード時にランダム生成する。**利用者が送ったファイル名は使わない。**
  imageKey         String?       @map("image_key")
  /// サーバー側で中身を検査して判定した MIME タイプ。拡張子は信用しない。
  imageContentType String?       @map("image_content_type")
  imageByteSize    Int?          @map("image_byte_size")
  /// 画像の内容ハッシュ（`sha256:<hex>`）。保存時に**中身から**計算する。
  /// Wallet の Holding 表示情報の同一性確認に使う（PR-NW04 §23）。
  /// ⚠️ ファイル名や URL から導出しない。差し替えを検出できなくなる。
  imageHash        String?       @map("image_hash")
  maxSupply        Int           @map("max_supply")
  /// 決済待ちの注文が押さえている数。
  reservedCount    Int           @default(0) @map("reserved_count")
  /// 受取権として発行済みの数。
  issuedCount      Int           @default(0) @map("issued_count")
  status           ArtworkStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  listings     Listing[]
  orderLines   OrderLine[]
  entitlements Entitlement[]
  reservations InventoryReservation[]

  @@index([status])
  /// 出品者が「自分の作品」を引くための索引。一覧のたびに全件走査させない。
  @@index([creatorAccountId, createdAt])
  @@map("artworks")
}

enum ListingStatus {
  draft
  scheduled
  active
  suspended
  ended
}

model Listing {
  id                  String        @id @default(uuid()) @db.Uuid
  artworkId           String        @map("artwork_id") @db.Uuid
  /// 最小通貨単位の整数。金額に浮動小数点を使わない。
  priceAmount         Int           @map("price_amount")
  priceCurrency       String        @map("price_currency") @db.Char(3)
  maxQuantityPerOrder Int           @default(1) @map("max_quantity_per_order")
  status              ListingStatus @default(draft)
  startsAt            DateTime?     @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?     @map("ends_at") @db.Timestamptz(6)
  /// 一覧での並び順。小さいほど前に出る。
  displayOrder        Int           @default(0) @map("display_order")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  artwork      Artwork                @relation(fields: [artworkId], references: [id])
  orderLines   OrderLine[]
  reservations InventoryReservation[]

  @@index([artworkId])
  @@index([status, startsAt, endsAt])
  @@index([displayOrder])
  @@map("listings")
}

// ============================================================================
// 注文と決済
// ============================================================================

/// 注文の進み具合（決済 Phase P0・P1・指示書 §7）。
///
/// ⚠️ `failed` と `refunded` は**新しい注文では使わない**。
/// 決済の失敗は `payment_status`、返金は `refund_status` が持つ。
/// 列挙型から消すと過去の行が読めなくなるため、値だけ残してある。
/// 新しい注文がそこへ遷移しないことは、ドメインの遷移表が守る。
enum OrderStatus {
  pending
  checkout_created
  paid
  expired
  cancelled
  failed
  refunded
}

/// 注文が生まれた経路。
///
/// ⚠️ **`entitlements.order_id` の NOT NULL を緩めないために存在する。**
/// staging の動作確認では「注文の無い受取権」を作りたくなるが、
/// 列を NULL 許容へ変えると、その穴は**本番の経路にも開く**。
/// 代わりに Fixture 側で本物の Order / OrderLine を作り、
/// この列で出自を区別する（PR-NW04 §7）。
enum OrderSource {
  /// 通常の購入。
  PURCHASE
  /// staging 動作確認用の Fixture が作ったもの。決済は一切伴わない。
  STAGING_FIXTURE
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  /// 人が読み上げ、問い合わせで使う番号。⚠️ 参照の正は `id` のまま。
  orderNumber           String      @unique @map("order_number")
  accountId             String      @map("account_id") @db.Uuid
  /// 共通顧客ID。まだ解決できていない購入者があるため NULL を許す。
  commonUserId          String?     @map("common_user_id")
  /// ⚠️ 1 注文 1 クリエイター（指示書 §3-4）。明細と必ず一致させる。
  creatorAccountId      String      @map("creator_account_id") @db.Uuid
  status                OrderStatus @default(pending)
  /// 出自。既定は購入。Fixture だけが `STAGING_FIXTURE` を入れる。
  source                OrderSource @default(PURCHASE)
  /// 商品の税込価格（単価 × 数量）。
  subtotalAmount        Int         @map("subtotal_amount")
  /// 値引額。⚠️ 今回は常に 0。列と計算だけ先に用意してある。
  discountAmount        Int         @default(0) @map("discount_amount")
  /// 購入者が支払う額。`subtotal - discount` と CHECK 制約で一致させる。
  totalAmount           Int         @map("total_amount")
  totalCurrency         String      @map("total_currency") @db.Char(3)
  /// 注文時点の手数料率。⚠️ **bps（1/100 %）の整数**。
  /// 率を小数で持つと、金額に掛けた瞬間に誤差が入る。
  platformFeeRateBps    Int         @default(0) @map("platform_fee_rate_bps")
  platformFeeAmount     Int         @default(0) @map("platform_fee_amount")
  /// クリエイター配分額。`total - platformFee` と CHECK 制約で一致させる。
  creatorAmount         Int         @map("creator_amount")
  /// ⚠️ 4 つの状態を 1 本に詰め込まない（指示書 §7）。
  /// 「決済は成功したが付与に失敗した」を表せなくなる。
  paymentStatus         String      @default("not_started") @map("payment_status")
  fulfillmentStatus     String      @default("not_started") @map("fulfillment_status")
  refundStatus          String      @default("none") @map("refund_status")
  /// 二重注文を防ぐ冪等キー。アプリの重複チェックではなく UNIQUE 制約で担保する。
  idempotencyKey        String      @map("idempotency_key")
  /// 注文時点で施行されていた利用規約の版（`UD-126`）。
  /// ⚠️ **同意の記録ではない。** 「何が表示されていたか」の記録で、
  /// 価格・手数料率と同じスナップショット原則。改定しても過去の注文は動かない。
  /// ⚠️ 規約を公開していない時期の注文があるため NULL を許す。
  /// 無いことを、無いまま残す。
  termsVersionId        String?     @map("terms_version_id") @db.Uuid
  termsVersion          Int?        @map("terms_version")
  /// 在庫の仮引当の期限。過ぎたらワーカーが解放する。
  reservedUntil         DateTime?   @map("reserved_until") @db.Timestamptz(6)
  paidAt                DateTime?   @map("paid_at") @db.Timestamptz(6)
  /// 返金を受け付ける期限（`UD-104`）。
  ///
  /// ⚠️ **決済確定の時点で確定して書く。** 「決済日 + 設定値」を判定のたびに
  /// 計算しない。計算すると、14 日 → 30 日に変えた瞬間、精算済みの注文が
  /// 「まだ返金できる」に化ける。
  refundableUntil       DateTime?   @map("refundable_until") @db.Timestamptz(6)
  /// 受取権の発行の再試行（P0-1）。
  ///
  /// ⚠️ **ここに置くのは「何回試したか」だけで、「何をすべきか」ではない。**
  /// 作るべき受取権の数は、注文明細の数量と `entitlements` の実物から
  /// 導く。列が消えても、作るべき枚数は変わらない。
  /// ⚠️ 待ち行列の表を別に作っていないのは、行を足す方式だと
  /// 「入れ忘れ」「行だけ残る」という実物と食い違う壊れ方が増えるため。
  issuanceAttemptCount  Int         @default(0) @map("issuance_attempt_count")
  issuanceNextAttemptAt DateTime?   @map("issuance_next_attempt_at") @db.Timestamptz(6)
  /// ⚠️ **応答本文をそのまま入れない。** こちらで決めた短い符号だけ。
  issuanceLastError     String?     @map("issuance_last_error")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  account        Account                @relation(fields: [accountId], references: [id])
  creator        Account                @relation("OrderCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  termsDocument  LegalDocumentVersion?  @relation("OrderTermsVersion", fields: [termsVersionId], references: [id], onDelete: Restrict)
  lines          OrderLine[]
  payments       Payment[]
  entitlements   Entitlement[]
  reservations   InventoryReservation[]
  webhookEvents  WebhookEvent[]
  notes          OrderNote[]
  refunds        Refund[]
  payoutLines    PayoutLine[]
  // 返金の申請と審査（方針整理 2026-08-22）。
  refundRequests RefundRequest[]
  receivable     CreatorReceivable?

  /// ⚠️ 冪等キーの一意性はここが守る（指示書 §4.5）。
  /// アプリの重複チェックではなく、DB の制約で担保する。
  @@unique([accountId, idempotencyKey])
  @@index([status, reservedUntil])
  @@index([accountId, createdAt])
  @@index([creatorAccountId, createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)])
  /// 返金の窓が閉じた注文だけを精算するため（`UD-119`）。
  @@index([refundableUntil])
  /// 問い合わせ対応の検索（`UD-121`）。期間と金額から辿る。
  /// ⚠️ 注文番号の末尾一致と作品名の部分一致には索引を張っていない。
  /// `LIKE '%...'` は B-Tree で絞れないため（マイグレーションの注記参照）。
  @@index([createdAt(sort: Desc)])
  @@index([totalAmount])
  /// Fixture 由来の行を洗い出して掃除するため。
  @@index([source, createdAt])
  /// 返金済みの注文を洗い出すため（`UD-120`）。追随に失敗した行を探す。
  @@index([refundStatus, paidAt(sort: Desc)], map: "orders_refund_status_idx")
  @@map("orders")
}

/// 注文時点の作品名と価格をスナップショットする。
/// マスタを後から変更しても、過去の取引記録が書き換わらないようにするため。
model OrderLine {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  listingId            String   @map("listing_id") @db.Uuid
  artworkId            String   @map("artwork_id") @db.Uuid
  /// ⚠️ 出品者。注文時点のものを持つ。作品の持ち主が変わっても動かさない。
  creatorAccountId     String   @map("creator_account_id") @db.Uuid
  artworkTitleSnapshot String   @map("artwork_title_snapshot")
  /// 注文時点の作家さまの表示名（決定 2026-08-20）。
  /// ⚠️ **マスタを引き直さない。** 改名しても過去のご注文の表示は変わらない
  /// （作品名・価格・手数料率と同じスナップショット原則）。
  /// ⚠️ この列より前の注文があるため NULL を許す。**推測で埋めない。**
  creatorNameSnapshot  String?  @map("creator_name_snapshot")
  unitPriceAmount      Int      @map("unit_price_amount")
  unitPriceCurrency    String   @map("unit_price_currency") @db.Char(3)
  quantity             Int
  /// 単価 × 数量。CHECK 制約で一致を守る。
  totalAmount          Int      @map("total_amount")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order         @relation(fields: [orderId], references: [id])
  listing      Listing       @relation(fields: [listingId], references: [id])
  artwork      Artwork       @relation(fields: [artworkId], references: [id])
  creator      Account       @relation("OrderLineCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  entitlements Entitlement[]

  /// ⚠️ **MVP は 1 注文 1 明細**（指示書 §5.2）。
  /// `order_id` だけの UNIQUE が「明細は 1 本まで」を DB に守らせる。
  @@unique([orderId], map: "order_lines_single_item_per_order")
  @@map("order_lines")
}

/// 問い合わせの対応メモ（`UD-121`）。
///
/// ⚠️ **追記のみ。** 更新も削除もアプリから行わない。書き換えられる
/// 記録は、揉めたときに何の役にも立たない。訂正は新しいメモで行う。
///
/// ⚠️ **購入者の平文メールを書かない**（`UD-503`）。ドメインの
/// `validateOrderNote` がアドレスらしき並びを弾く。
model OrderNote {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  /// 書いた運営スタッフ。⚠️ 氏名やメールではなくアカウントIDで持つ。
  authorAccountId String   @map("author_account_id") @db.Uuid
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author Account @relation("OrderNoteAuthor", fields: [authorAccountId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

/// 作家さまへの精算（`UD-119`。docs/SETTLEMENT_AND_REFUND.md §3-3）。
///
/// ⚠️ **金額を人が直接書き換える口を作らない**（§4）。訂正は**次の期間での
/// 調整**として行う。直接書き換えを許すと、明細と振込額が食い違ったときに、
/// どちらが正しいのか誰にも分からなくなる。
///
/// ⚠️ **`confirmed` 以降は行を書き換えない。** 締めたあとに金額が動くと、
/// 作家さまへ渡した明細と食い違う。
model Payout {
  id                  String    @id @default(uuid()) @db.Uuid
  creatorAccountId    String    @map("creator_account_id") @db.Uuid
  /// 締め月。`2026-08` の形。⚠️ 表示にも識別にも使う。
  periodKey           String    @map("period_key")
  /// 締め期間。⚠️ **JST の月境界を UTC で保存する。** 終了は含まない。
  periodStart         DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd           DateTime  @map("period_end") @db.Timestamptz(6)
  /// お支払いの期日。⚠️ 焼き付ける。設定を変えても過去の精算は動かない。
  dueAt               DateTime  @map("due_at") @db.Timestamptz(6)
  /// `draft` / `confirmed` / `paid`。CHECK 制約で縛る。
  status              String    @default("draft")
  currency            String    @default("JPY") @db.Char(3)
  grossAmount         Int       @default(0) @map("gross_amount")
  feeAmount           Int       @default(0) @map("fee_amount")
  /// 差し戻した額。⚠️ 正の数で持つ。
  refundedAmount      Int       @default(0) @map("refunded_amount")
  /// 前月からの繰越。⚠️ マイナスもありうる。
  carriedInAmount     Int       @default(0) @map("carried_in_amount")
  /// 今回のお支払額。⚠️ 最低支払額に満たなければ 0。
  netAmount           Int       @default(0) @map("net_amount")
  /// 翌月への繰越。⚠️ マイナスもありうる。
  carriedOutAmount    Int       @default(0) @map("carried_out_amount")
  /// ⚠️ **その時点の**設定。焼き付けてある（§0 の②）。
  minimumPayoutAmount Int       @map("minimum_payout_amount")
  transferFeeBearer   String    @map("transfer_fee_bearer")
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  paidAt              DateTime? @map("paid_at") @db.Timestamptz(6)
  paidByAccountId     String?   @map("paid_by_account_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator Account      @relation("PayoutCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  paidBy  Account?     @relation("PayoutPayer", fields: [paidByAccountId], references: [id], onDelete: SetNull)
  lines   PayoutLine[]

  /// ⚠️ 1 作家さま × 1 締め期間 = 1 行。2 つできると、どちらが正か分からない。
  @@unique([creatorAccountId, periodKey], map: "payouts_creator_period_key")
  @@index([periodKey, status], map: "payouts_period_status_idx")
  @@index([creatorAccountId, createdAt(sort: Desc)], map: "payouts_creator_created_idx")
  @@map("payouts")
}

/// 精算の明細（注文 1 件ぶん）。
///
/// ⚠️ 部分 UNIQUE 索引 `payout_lines_order_key`（`WHERE is_clawback = false`）が
/// **二重払い**を止める。Prisma では条件付き索引を書けないため、**手書きの
/// マイグレーション側にだけ存在する**。消さないこと。
model PayoutLine {
  id                   String   @id @default(uuid()) @db.Uuid
  payoutId             String   @map("payout_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  orderNumber          String   @map("order_number")
  /// ⚠️ 注文時点の作品名。マスタを引き直さない。改名しても明細は変わらない。
  artworkTitleSnapshot String   @map("artwork_title_snapshot")
  grossAmount          Int      @map("gross_amount")
  feeRateBps           Int      @map("fee_rate_bps")
  feeAmount            Int      @map("fee_amount")
  /// ⚠️ 差し戻しはマイナス。合計だけ減らすと、作家さまが理由を読み取れない。
  netAmount            Int      @map("net_amount")
  /// 確定済みの精算に載った注文の返金を、次回で差し引く行。
  isClawback           Boolean  @default(false) @map("is_clawback")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([payoutId], map: "payout_lines_payout_idx")
  @@map("payout_lines")
}

/// 返金の記録（`UD-104` / `UD-120`。docs/SETTLEMENT_AND_REFUND.md §3-2）。
///
/// ⚠️ **追記のみ。取り消す口を作らない。** 間違えたら再課金であって、
/// 記録を消すことではない。状態を進める UPDATE だけを許す。
///
/// ⚠️ **事業者の画面から返金されるケースを前提にする。** 運営が慌てて
/// Stripe の画面から返すのは実際に起きる。`initiated_by` で必ず分けて
/// 残す。丸めると、こちらを経由していない返金が見分けられなくなる。
///
/// ⚠️ 部分 UNIQUE 索引 `refunds_provider_ref_key`
/// （`WHERE provider_refund_ref IS NOT NULL`）が「同じ返金を 2 回積まない」
/// を守る。Prisma では条件付き索引を書けないため、**手書きの
/// マイグレーション側にだけ存在する**。消さないこと。
model Refund {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  /// どの決済を戻したか。⚠️ 世代の鍵はここから解決する（`UD-118`）。
  /// ⚠️ 決済行を特定できない事業者発の返金があるため NULL を許す。
  paymentId         String?   @map("payment_id") @db.Uuid
  /// 戻した額（円）。⚠️ 最小通貨単位の整数。
  amount            Int
  currency          String    @db.Char(3)
  /// `buyer_request` / `our_fault` / `provider_initiated`。CHECK 制約で縛る。
  /// ⚠️ 事業者の文言をそのまま入れない。
  reason            String
  /// `admin` / `provider`。CHECK 制約で縛る。
  initiatedBy       String    @map("initiated_by")
  /// 誰が行ったか。⚠️ `provider` なら NULL（CHECK 制約で守る）。
  actorAccountId    String?   @map("actor_account_id") @db.Uuid
  /// `requested` / `succeeded` / `failed`。CHECK 制約で縛る。
  status            String    @default("requested")
  /// 事業者側の識別子。⚠️ 二重反映を防ぐ鍵。
  providerRefundRef String?   @map("provider_refund_ref")
  /// 失敗の分類。⚠️ 事業者の符号をそのまま入れない。
  failureCode       String?   @map("failure_code")
  /// 運用の注記。⚠️ 事業者の応答本文を入れない。
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  settledAt         DateTime? @map("settled_at") @db.Timestamptz(6)

  /// この返金を誰が被るか（決定 2026-08-22）。`platform` / `creator`。
  /// ⚠️ **作家さま負担の分だけが、次回以降の精算で差し引かれる。**
  ///    こちらの落ち度・チャージバック・運営が例外として通したものは
  ///    `platform`（作家さまへ回さない）。
  clawbackBearer String  @default("creator") @map("clawback_bearer")
  /// どの申請から実行されたか（方針整理 2026-08-22）。
  /// ⚠️ **NULL 可のまま。** これまでの返金は申請を持たない。
  requestId      String? @map("request_id") @db.Uuid

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor   Account?       @relation("RefundActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  request RefundRequest? @relation("RefundFromRequest", fields: [requestId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)], map: "refunds_order_created_idx")
  /// 事業者へ届かないまま残った行を洗い出すため。
  @@index([status, createdAt], map: "refunds_status_created_idx")
  @@map("refunds")
}

/// 在庫の仮引当（決済 Phase P0・P1・指示書 §5.3）。
///
/// ⚠️ **在庫を減らす前の「押さえ」を、注文とは別の行として持つ。**
/// 注文の列に期限だけ書く方式だと、「解放したか」を注文の状態から
/// 推測することになり、二重解放と解放漏れのどちらも静かに起こる。
/// 行にして状態を持たせると、解放は「reserved の行を released にする」
/// という 1 回しか成立しない操作になる。
///
/// ⚠️ 部分 UNIQUE 索引 `inventory_reservations_one_active_per_order`
/// （`WHERE status = 'reserved'`）が「1 注文に有効な予約は 1 件」を守る。
/// Prisma のスキーマでは条件付き索引を書けないため、
/// **手書きのマイグレーション側にだけ存在する**。消さないこと。
model InventoryReservation {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  listingId  String    @map("listing_id") @db.Uuid
  artworkId  String    @map("artwork_id") @db.Uuid
  quantity   Int
  /// `reserved` / `consumed` / `released`。CHECK 制約で縛る。
  status     String    @default("reserved")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Restrict)

  /// 期限切れの掃き出しで使う。全件走査させない。
  @@index([status, expiresAt], map: "inventory_reservations_expiry_idx")
  @@map("inventory_reservations")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  /// 支払い口の期限切れ・利用者の取消。⚠️ `failed`（カード拒否など）と分ける。
  cancelled
  refunded
  partially_refunded
}

/// 決済の真の状態は常に外部の決済事業者側にある。
/// 本テーブルは Webhook で受け取った事実の写像であり、
/// 本システム側から状態を推測して進めない。
model Payment {
  id                     String        @id @default(uuid()) @db.Uuid
  orderId                String        @map("order_id") @db.Uuid
  provider               String
  /// Stripe Checkout Session（Phase P2 で埋める）。
  providerSessionRef     String?       @map("provider_session_ref")
  /// Stripe Payment Intent（Phase P2 で埋める）。
  providerPaymentRef     String?       @map("provider_payment_ref")
  /// Stripe Charge（Phase P2 で埋める）。
  providerChargeRef      String?       @map("provider_charge_ref")
  /// 決済事業者へ渡す冪等キー。⚠️ 業務の冪等キーとは別物。
  providerIdempotencyKey String?       @map("provider_idempotency_key")
  status                 PaymentStatus @default(pending)
  amount                 Int
  currency               String        @db.Char(3)
  amountRefunded         Int           @default(0) @map("amount_refunded")
  paidAt                 DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// 支払い口が閉じる時刻。⚠️ お取り置きの期限を超えない。
  expiresAt              DateTime?     @map("expires_at") @db.Timestamptz(6)
  /// 利用者を送る先。⚠️ **管理画面へ出さない。** これを持つ人は誰でも
  /// その注文を支払える。運用に要るのは識別子までで、URL は要らない。
  checkoutUrl            String?       @map("checkout_url")
  failureCode            String?       @map("failure_code")
  /// ⚠️ 外部の応答本文をそのまま入れない。運用が読むための短い要約だけ。
  failureMessageSafe     String?       @map("failure_message_safe")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// この決済をどの世代の鍵で処理したか（`UD-118`）。
  /// ⚠️ **返金と照会はこの世代の鍵で行う。** 無いと、運営会社の切り替え後に
  /// 「どの鍵で返せばよいか」を誰も判断できない。
  /// ⚠️ 移行のため NULL を許す。既存行を埋めたあとに締める。
  credentialId String? @map("credential_id") @db.Uuid

  order         Order              @relation(fields: [orderId], references: [id])
  credential    PaymentCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  webhookEvents WebhookEvent[]
  refunds       Refund[]

  /// ⚠️ 試行ごとに 1 行。失敗した行も消さない（決済 Phase P2 の決定 B）。
  /// 「何回目で何が起きたか」を説明できないと、問い合わせに答えられない。
  ///
  /// ⚠️ **1 注文に成功は 1 件だけ**という制約は、Prisma では書けない
  /// 部分 UNIQUE 索引（`WHERE status = 'succeeded'`）で守っている。
  /// 手書きのマイグレーション側にだけ存在する。消さないこと。
  @@unique([provider, providerPaymentRef])
  @@index([orderId])
  @@index([orderId, createdAt(sort: Desc)], map: "payments_order_created_idx")
  @@index([credentialId], map: "payments_credential_idx")
  @@map("payments")
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed
}

/// 外部 Webhook の受信記録。二重処理防止の中核。
///
/// 処理順序: 署名検証 → 本テーブルへ INSERT（一意制約違反なら既受信として即 200）
///           → 業務処理 → processedAt 更新
///
/// 本文（payload）は保存せず、ダイジェストのみ持つ。
/// 本文には個人情報・カード関連情報が含まれうるため。
model WebhookEvent {
  id            String             @id @default(uuid()) @db.Uuid
  provider      String
  /// 送信元が採番したイベントID。
  eventId       String             @map("event_id")
  eventType     String             @map("event_type")
  /// 固定した API バージョン。形が変わったことに後から気づくため。
  apiVersion    String?            @map("api_version")
  /// 本番モードの事象か。⚠️ 試験の知らせで本番の注文を確定させないため。
  livemode      Boolean?
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(6)
  status        WebhookEventStatus @default(received)
  attemptCount  Int                @default(0) @map("attempt_count")
  payloadDigest String             @map("payload_digest")
  /// 失敗理由の要約。秘匿値を含めない。
  errorSummary  String?            @map("error_summary")
  /// ⚠️ 事業者の符号をそのまま入れない。こちらで決めた安全な符号だけ。
  lastErrorCode String?            @map("last_error_code")
  orderId       String?            @map("order_id") @db.Uuid
  paymentId     String?            @map("payment_id") @db.Uuid

  /// ⚠️ `Restrict`。既定の `SetNull` にすると、注文を消したときに
  /// 受信の記録だけが親を失って残る。注文と決済のデータは消さない決まり
  /// （指示書 §9.3）なので、消そうとした時点で止める。
  /// どの世代の署名で検証が通ったか（`UD-118`）。
  /// ⚠️ 旧アカウントからも知らせは届き続ける。これが無いと、
  /// 届いているのに処理されない事象を追えない。
  credentialId String? @map("credential_id") @db.Uuid

  order      Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment    Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  credential PaymentCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  /// ⚠️ **本文の全体を保存しない**（指示書 §10）。残すのは digest だけ。
  /// カード情報・個人情報・秘密が混ざる余地を作らない。
  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([orderId, receivedAt(sort: Desc)], map: "webhook_events_order_idx")
  @@map("webhook_events")
}

// ============================================================================
// 受取権（本ドメインの中核）
// ============================================================================

enum EntitlementStatus {
  issued
  claimed
  expired
  revoked
}

/// 「1枚のトークンを受け取る権利」。
/// 数量Nの注文に対し **N 行**作成する。注文が数量を持つのではなく、
/// 注文がN個の受取権を生む、という粒度でモデル化している。
///
/// claimed への遷移は条件付き UPDATE（WHERE status = 'issued'）で行い、
/// 更新行数が 1 の場合のみ成功とする。同時 Claim でも 1 回しか成功しない。
model Entitlement {
  id                    String            @id @default(uuid()) @db.Uuid
  orderId               String            @map("order_id") @db.Uuid
  orderLineId           String            @map("order_line_id") @db.Uuid
  artworkId             String            @map("artwork_id") @db.Uuid
  /// 購入者。Claim の本人照合はこの値と認証アカウントの一致で行う。
  accountId             String            @map("account_id") @db.Uuid
  serialNo              Int               @map("serial_no")
  /// 注文明細の中での通し番号（0 始まり）。
  /// ⚠️ **二重発行を止める鍵。** `UNIQUE(order_line_id, unit_index)` で、
  ///    同じ Webhook が何度届いても 2 枚目を DB が弾く。
  /// ⚠️ `serial_no`（作品の中の通し番号）では代われない。あちらは
  ///    「この注文明細の何枚目か」を表さないため、再開時に数えられない。
  unitIndex             Int               @map("unit_index")
  /// Claim トークンのハッシュ。**平文は保存しない。**
  claimTokenHash        String            @map("claim_token_hash")
  status                EntitlementStatus @default(issued)
  /// Claim 期限。null は無期限（UD-505 で未決定のため MVP は null）。
  expiresAt             DateTime?         @map("expires_at") @db.Timestamptz(6)
  claimedByAccountId    String?           @map("claimed_by_account_id") @db.Uuid
  claimedAt             DateTime?         @map("claimed_at") @db.Timestamptz(6)
  /// Wallet 経由で受け取った本人の `common_user_id`。
  /// ⚠️ 受取時点の値を**そのまま残す**。あとでマスタが変わっても遡って書き換えない。
  claimedByCommonUserId String?           @map("claimed_by_common_user_id")
  /// Wallet への配送状態。not_started / pending / delivered。
  /// ⚠️ `delivered` へ進めてよいのは、Wallet が 2xx を返し、
  ///    それが Holding の永続化を意味する場合のみ（PR-NW04 §21）。
  walletDeliveryStatus  String            @default("not_started") @map("wallet_delivery_status")
  /// 配送が完了した時刻。`walletDeliveryStatus = 'delivered'` と必ず同時に入る。
  walletDeliveredAt     DateTime?         @map("wallet_delivered_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order            Order                  @relation(fields: [orderId], references: [id])
  orderLine        OrderLine              @relation(fields: [orderLineId], references: [id])
  artwork          Artwork                @relation(fields: [artworkId], references: [id])
  purchaser        Account                @relation("EntitlementPurchaser", fields: [accountId], references: [id])
  claimedByAccount Account?               @relation("EntitlementClaimer", fields: [claimedByAccountId], references: [id])
  mintJob          MintJob?
  nftToken         NftToken?
  walletDeliveries WalletDeliveryOutbox[]

  /// 同一作品内でシリアル番号が重複しないことを物理的に担保する。
  @@unique([artworkId, serialNo])
  /// 同じ注文明細の同じ枚数目を 2 度作らせない（P0-1 の冪等の鍵）。
  @@unique([orderLineId, unitIndex], map: "entitlements_line_unit_unique")
  /// トークンの衝突を検出する。
  @@unique([claimTokenHash])
  @@index([accountId, status])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("entitlements")
}

// ============================================================================
// 発行（Mint）
// ============================================================================

enum MintJobStatus {
  queued
  processing
  succeeded
  failed
  cancelled
}

/// 発行ジョブ。ワーカーが FOR UPDATE SKIP LOCKED で排他取得する。
///
/// entitlementId の UNIQUE により、1つの受取権に対してジョブは 1 件しか作れない。
/// これが「1つの受取権から複数Mintできない」ことを担保する4層のうちの1つ。
///
/// ⚠️ **発行先チェーンの列を意図的に置いていない。**
///    マルチチェーン対応の要否が未決定（UD-512）で、チェーン選定（UD-501）と
///    同時に判断する。本テーブルに本番データが入るのは Phase 5 以降なので、
///    決定後に列を足しても安く済む（既存行の埋め戻しも自明）。
///    記録側の nft_tokens には chainRef があり、そちらは単一チェーン運用でも保持する。
model MintJob {
  id             String        @id @default(uuid()) @db.Uuid
  entitlementId  String        @unique @map("entitlement_id") @db.Uuid
  status         MintJobStatus @default(queued)
  attemptCount   Int           @default(0) @map("attempt_count")
  maxAttempts    Int           @default(5) @map("max_attempts")
  /// バックオフ後の実行予定時刻。
  nextAttemptAt  DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// processing 開始時刻。滞留の検出に使う。
  lockedAt       DateTime?     @map("locked_at") @db.Timestamptz(6)
  /// 外部Mint APIへ渡す冪等キー。受取権IDから決定論的に導出する。
  idempotencyKey String        @unique @map("idempotency_key")
  /// プロバイダ側の依頼識別子。状態問い合わせに使う。
  submissionRef  String?       @map("submission_ref")
  /// 失敗理由の分類コード。外部APIの生メッセージを入れない。
  lastErrorCode  String?       @map("last_error_code")
  /// 運用注記。processing 中の行を返金で取り消せない場合などに記録する。
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlement Entitlement @relation(fields: [entitlementId], references: [id])
  nftToken    NftToken?

  @@index([status, nextAttemptAt])
  @@map("mint_jobs")
}

/// 発行済みトークンへの参照。
///
/// entitlementId の UNIQUE が「1受取権1トークン」の最終的な担保。
/// 万一ジョブが2回実行されても、記録は1件しか作られない。
///
/// ⚠️ chainRef / contractRef / tokenRef / ownerRef は **不透明な文字列**にしてある。
///    チェーン仕様が未決定（UD-501）のため、EVM のアドレス形式などに固定しない。
///    決定後に CHECK 制約や正規化を追加する。
model NftToken {
  id            String   @id @default(uuid()) @db.Uuid
  entitlementId String   @unique @map("entitlement_id") @db.Uuid
  mintJobId     String   @unique @map("mint_job_id") @db.Uuid
  chainRef      String   @map("chain_ref")
  contractRef   String   @map("contract_ref")
  tokenRef      String   @map("token_ref")
  txRef         String?  @map("tx_ref")
  /// 所有者参照。カストディ方式が未決定（UD-502）のため不透明参照。
  ownerRef      String   @map("owner_ref")
  metadataUri   String?  @map("metadata_uri")
  mintedAt      DateTime @map("minted_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entitlement Entitlement @relation(fields: [entitlementId], references: [id])
  mintJob     MintJob     @relation(fields: [mintJobId], references: [id])

  @@unique([chainRef, contractRef, tokenRef])
  @@index([ownerRef])
  @@map("nft_tokens")
}

// ============================================================================
// イベントと監査
// ============================================================================

enum OutboxStatus {
  pending
  published
  failed
}

/// Transactional Outbox。
/// 業務データの更新と同一トランザクションでイベント行を書き、
/// 別プロセスが配信する。「支払は確定したが通知が飛ばなかった」を防ぐ。
///
/// payload に個人情報を含めない。イベントは複数の購読者・ログを経由するため。
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventName     String       @map("event_name")
  eventVersion  Int          @default(1) @map("event_version")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  status        OutboxStatus @default(pending)
  attemptCount  Int          @default(0) @map("attempt_count")

  @@index([status, occurredAt])
  @@map("outbox_events")
}

enum WalletDeliveryOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD
  /// 取消に追い越されたため、もう送らない付与イベント。**終端。**
  ///
  /// ⚠️ 全額返金で取り消した受取権について、まだ送っていない
  ///    entitlement.granted を残したまま自動配送させると、取り消したはずの
  ///    作品があとから相手側に現れる。
  /// ⚠️ 行は消さない。「送ろうとしていた」事実は残す。
  /// ⚠️ claimBatch（PENDING のみ）にも requeue（FAILED / DEAD のみ）にも
  ///    拾われない。手動再送の対象にもならない。
  SUPERSEDED
}

/// OVEW Wallet への配送待ち行列（PR-NW04 §10）。
///
/// ⚠️ **`outbox_events` とは別のテーブルにしてある。**
/// あちらは「業務で起きた事実」の記録で、購読者が何であっても内容は変わらない。
/// こちらは「特定の相手へ HTTP で届ける仕事」で、宛先・試行回数・
/// 打ち切りといった**配送の都合**を持つ。1 つの表に混ぜると、
/// 事実の記録が配送の再試行で書き換わる。
///
/// ⚠️ **行の作成は業務状態の変更と同一トランザクションで行う。**
/// Claim を確定してから別途 INSERT すると、その間に落ちたときに
/// 「受け取ったのに Wallet へ届かない」行が誰にも気づかれず残る。
///
/// ⚠️ **`event_id` は再試行で作り直さない。**
/// 相手の冪等キーがこの値なので、作り直すと再試行のたびに
/// 別のイベントとして扱われ、Holding が重複しうる。
model WalletDeliveryOutbox {
  id               String                     @id @default(uuid()) @db.Uuid
  /// 送信側が採番するイベントID。**相手の Idempotency-Key と同じ値**。
  /// UNIQUE が二重配送を防ぐ最後の砦（アプリの重複チェックは競合で破れる）。
  eventId          String                     @unique @map("event_id")
  eventType        String                     @map("event_type")
  entitlementId    String                     @map("entitlement_id") @db.Uuid
  /// 宛先の識別子。現状は `ovew-wallet` のみ。
  targetSiteKey    String                     @map("target_site_key")
  /// 送信する本文の **JSON テキストそのもの**。
  ///
  /// ⚠️ **jsonb ではなく文字列で持つ。**
  /// 署名は「送るバイト列そのもの」に対して行う（HMAC v1.1）。
  /// jsonb に入れると Postgres がキー順と空白を正規化するため、
  /// 読み戻して stringify した文字列は**入れたときと別物**になりうる。
  /// 保存・署名・送信で 3 通りの本文が生まれる余地を、型で消しておく。
  ///
  /// 送信時点のスナップショットであり、あとでマスタが変わっても
  /// 再試行の内容は変わらない（§24）。
  /// ⚠️ 個人情報を入れない。入れてよいのは `common_user_id` まで。
  payload          String
  /// 本文の内容ハッシュ（`sha256:<hex>`）。`payload` の文字列に対して計算する。
  payloadHash      String                     @map("payload_hash")
  status           WalletDeliveryOutboxStatus @default(PENDING)
  attemptCount     Int                        @default(0) @map("attempt_count")
  maxAttempts      Int                        @default(5) @map("max_attempts")
  /// バックオフ後の実行予定時刻。
  nextRetryAt      DateTime                   @default(now()) @map("next_retry_at") @db.Timestamptz(6)
  /// 失敗理由の分類コード。外部の生メッセージを入れない。
  lastErrorCode    String?                    @map("last_error_code")
  /// 運用が読むための要約。⚠️ 応答本文をそのまま入れない（秘匿値が混ざりうる）。
  lastErrorMessage String?                    @map("last_error_message")
  /// Claim から配送まで同じ値を引き継ぐ（§17）。
  correlationId    String                     @map("correlation_id")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveredAt      DateTime?                  @map("delivered_at") @db.Timestamptz(6)

  entitlement Entitlement @relation(fields: [entitlementId], references: [id])

  @@index([status, nextRetryAt])
  @@index([entitlementId])
  @@map("wallet_delivery_outbox")
}

/// 管理操作の監査証跡。
/// summary には業務値のみを入れ、秘匿値を含めない。
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  /// null はシステムによる自動操作。
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  summary        Json
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor Account? @relation(fields: [actorAccountId], references: [id])

  @@index([targetType, targetId, occurredAt])
  @@index([actorAccountId, occurredAt])
  @@map("audit_logs")
}

/// 冪等キー。同じ操作が 2 回実行されないようにする。
///
/// ⚠️ **保存先をプロセス内メモリにしない。**
/// メモリだと台数を増やした瞬間に効かなくなり、しかも
/// 「効いていない」ことが見た目には分からない。
/// 取り返しのつかない操作（注文・決済）を扱う前に DB へ移す。
///
/// ⚠️ **「探してから書く」のではなく「先に占有する」。**
/// 探す→無い→処理する、の順だと、同時に来た 2 本が両方とも
/// 「無い」を見て両方処理してしまう。UNIQUE 制約で先に場所を取り、
/// 取れた 1 本だけが処理する。
model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  /// キーはアクターごとに区切る。区切らないと他人のキーを当てて応答を読める。
  actorAccountId String    @map("actor_account_id") @db.Uuid
  key            String
  /// リクエスト内容のハッシュ。値そのものは保持しない。
  requestDigest  String    @map("request_digest")
  /// in_progress … 占有だけした状態 / completed … 応答を記録済み
  status         String
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  actor Account @relation(fields: [actorAccountId], references: [id], onDelete: Cascade)

  @@unique([actorAccountId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// 署名の使い捨て値（nonce）。リプレイ攻撃を防ぐ。
///
/// ⚠️ **一意制約そのものが判定。**
/// 「探して無ければ受け付ける」だと、同時に届いた 2 本が両方通る。
/// INSERT を試みて弾かれたかどうかで、使用済みかを決める。
///
/// ⚠️ プロセス内メモリに置かない。台数を増やすと別プロセスの記録が
/// 見えず、リプレイを素通しする。しかもその事実が外からは見えない。
model HmacNonce {
  id        String   @id @default(uuid()) @db.Uuid
  keyId     String   @map("key_id")
  nonce     String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  /// この時刻を過ぎたら掃除してよい。署名の許容時間より少し先。
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([keyId, nonce])
  @@index([expiresAt])
  @@map("hmac_nonces")
}

/// 返金と精算の設定（`UD-104` / `UD-119`。決定 2026-08-20）。
///
/// ⚠️ **環境ごとに 1 行。** これは「いま何を使うか」であって、
/// 過去の記録の説明ではない。使った値は注文・返金・精算へ焼き付ける。
///
/// ⚠️ **既定値をコードに書かない。** 初期値はマイグレーションで一度入れる。
/// コードに `?? 14` を書くと、設定行が消えたことに誰も気づかないまま動く。
model SettlementSettings {
  /// `staging` / `production`。⚠️ CHECK で縛っている。
  environment                 String   @id
  /// 返金を受け付ける日数。⚠️ 0 は「受け付けない」であって未設定ではない。
  refundWindowDays            Int      @map("refund_window_days")
  /// 締めから支払いまでの月数。1 = 月末締め・翌月末払い。
  payoutOffsetMonths          Int      @map("payout_offset_months")
  /// 最低支払額（円）。未満は翌月へ繰り越す。
  minimumPayoutAmount         Int      @map("minimum_payout_amount")
  /// `creator` / `platform`。⚠️ CHECK で縛っている。
  transferFeeBearer           String   @map("transfer_fee_bearer")
  /// 作家さまの回答期限（営業日・方針整理 2026-08-22）。
  /// ⚠️ **祝日は見ていない**（表を持たないため）。連休のある月は実際より短くなる。
  creatorInquiryBusinessDays  Int      @default(3) @map("creator_inquiry_business_days")
  /// 二重承認が要る金額。⚠️ **`null` は「二重承認を使わない」。**
  /// 0 を「常に要る」の意味に使わない（設定漏れと区別できなくなる）。
  dualApprovalThresholdAmount Int?     @map("dual_approval_threshold_amount")
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByAccountId          String?  @map("updated_by_account_id") @db.Uuid

  updatedBy Account? @relation("SettlementSettingsEditor", fields: [updatedByAccountId], references: [id], onDelete: SetNull)

  @@map("settlement_settings")
}

/// 運用確認キュー（M3a）。「機械では決められなかったこと」を残す。
///
/// ⚠️ **ログ出力で済ませない。** ログは流れて消える。人が確認するべき事柄は、
/// 未対応か対応済みかを持った行として残らないと、忙しい日にそのまま埋もれる。
///
/// ⚠️ **業務処理を止めない。** ここへ積むのは「返金は成立したが、付随する
/// 判断が残っている」という状況である。積めなかったからといって返金は
/// 巻き戻さない。積む処理は例外を投げてはならない。
///
/// ⚠️ **同じ対象・同じ理由を 2 行にしない。** 返金の Webhook は同じものが
/// 何度も届く。そのたびに確認事項が増えると「いま何件残っているか」が
/// 意味を失い、誰も見なくなる。
/// UNIQUE `operations_reviews_subject_reason_unique` が止める。
model OperationsReview {
  id                  String    @id @default(uuid()) @db.Uuid
  /// `order` / `entitlement`。⚠️ CHECK で縛っている。
  subjectType         String    @map("subject_type")
  subjectId           String    @map("subject_id") @db.Uuid
  /// 辿るための注文。⚠️ **外部キーを張っていない。** 確認事項は業務データより
  /// 長生きしてよく、注文側の削除制約に引きずられたくない。
  orderId             String?   @map("order_id") @db.Uuid
  /// なぜ確認が要るか。⚠️ 固定コードのみ。CHECK で語彙を縛っている。
  reasonCode          String    @map("reason_code")
  /// 機械が判断できなかった理由。⚠️ 個人情報・秘密値を入れない。
  detail              String
  /// `open` / `resolved`。⚠️ CHECK で縛っている。
  status              String    @default("open")
  resolvedByAccountId String?   @map("resolved_by_account_id") @db.Uuid
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// 対応の記録。⚠️ 個人情報を入れない。
  resolutionNote      String?   @map("resolution_note")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  resolvedBy Account? @relation("OperationsReviewResolver", fields: [resolvedByAccountId], references: [id], onDelete: SetNull)

  @@unique([subjectType, subjectId, reasonCode], map: "operations_reviews_subject_reason_unique")
  @@index([status, createdAt])
  @@index([orderId])
  @@map("operations_reviews")
}

// ============================================================================
// 購入者への知らせ（実運営 指示書 P0-4）
// ============================================================================

/// 知らせの文面。
///
/// ⚠️ **文面をコードへ書かない。** 直すたびにデプロイが要る作りにすると、
/// 文言の修正という最も頻度の高い運用が、毎回開発待ちになる。
///
/// ⚠️ **公開した版は書き換えない。** 送信履歴がこの版を指しているため、
/// 書き換えると「そのとき何と書いて送ったか」が復元できなくなる。
/// 直すときは新しい版を作る。
///
/// ⚠️ **削除の口を作らない。** 参照している履歴が孤児になる。
model NotificationTemplate {
  id                 String    @id @default(uuid()) @db.Uuid
  /// 知らせの種別。⚠️ CHECK で語彙を縛っている。
  eventType          String    @map("event_type")
  /// 版。⚠️ 種別ごとに 1 から採番する。
  version            Int
  subject            String
  body               String
  /// `draft` / `published`。⚠️ CHECK で縛っている。
  status             String    @default("draft")
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  createdByAccountId String?   @map("created_by_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventType, version], map: "notification_templates_event_version_unique")
  @@index([eventType, status])
  @@map("notification_templates")
}

/// 送信待ちと送信履歴。
///
/// ⚠️ **積むのは業務更新と同一トランザクション、送るのはコミットのあと。**
/// 先に送ると、業務側が巻き戻ったときに「起きていないこと」を知らせる。
/// あとから積むと、そのあいだに落ちた注文が誰にも知らされずに残る。
///
/// ⚠️ **宛先の平文を持たない**（`UD-503`）。送るときに認証基盤から取り直し、
/// ここへ残すのは伏せた表記と照合用のハッシュだけ（決定 2026-08-20）。
///
/// ⚠️ **本文は積んだ時点で確定させる。** 送るたびに作り直すと、そのあいだに
/// 文面を直した場合、1 通目と 2 通目で違う内容が同じ知らせとして送られる。
model NotificationDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  eventType         String    @map("event_type")
  /// `order` / `entitlement` / `refund`。⚠️ CHECK で縛っている。
  subjectType       String    @map("subject_type")
  subjectId         String    @map("subject_id") @db.Uuid
  /// 宛先の本人。⚠️ アドレスそのものは持たない。
  accountId         String    @map("account_id") @db.Uuid
  /// 焼き付けた文面。⚠️ 送信時に組み立て直さない。
  renderedSubject   String    @map("rendered_subject")
  renderedBody      String    @map("rendered_body")
  /// 使った文面の版。⚠️ あとから何を送ったかを辿る鍵。
  templateVersion   Int       @map("template_version")
  /// PENDING / PROCESSING / SENT / FAILED / DEAD / SKIPPED。CHECK で縛る。
  status            String    @default("PENDING")
  attemptCount      Int       @default(0) @map("attempt_count")
  maxAttempts       Int       @default(5) @map("max_attempts")
  nextRetryAt       DateTime  @default(now()) @map("next_retry_at") @db.Timestamptz(6)
  /// 伏せた宛先（`t*****@e******.jp`）。⚠️ ここから元へは戻せない。
  maskedRecipient   String?   @map("masked_recipient")
  /// 照合用のハッシュ。⚠️ 鍵付き（`EMAIL_LOOKUP_PEPPER`）。素のハッシュにしない。
  recipientHash     String?   @map("recipient_hash")
  /// 送信事業者が採番した識別子。⚠️ 問い合わせのときに伝える値。
  providerMessageId String?   @map("provider_message_id")
  lastErrorCode     String?   @map("last_error_code")
  /// ⚠️ 応答本文をそのまま入れない（宛先が混ざりうる）。
  lastErrorMessage  String?   @map("last_error_message")
  /// 送らずに閉じた理由。⚠️ 失敗と混ぜない。
  skippedReasonCode String?   @map("skipped_reason_code")
  correlationId     String?   @map("correlation_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation("NotificationRecipient", fields: [accountId], references: [id], onDelete: Restrict)

  /// ★ 重複送信を止める最後の砦。同じ種別・同じ対象は 1 通だけ。
  /// 重複送信を止める最後の砦。
  /// ⚠️ **宛先まで入れる**（`UD-127`）。1 つの版を大勢へ送る知らせがあるため、
  /// 対象だけを鍵にすると 1 人目しか積まれない。止めたいのは「同じ知らせが
  /// 同じ人へ 2 通届くこと」であって、「1 つの対象について 2 人へ届くこと」
  /// ではない。
  @@unique([eventType, subjectType, subjectId, accountId], map: "notification_deliveries_event_subject_account_unique")
  @@index([status, nextRetryAt])
  @@index([accountId, createdAt])
  @@index([subjectId])
  @@map("notification_deliveries")
}

/// 時計仕掛けの生死（実運営 指示書 P0-6）。
///
/// ⚠️ **これが無いと「止まっている」を誰も検知できない。** 発行も配送も
/// 知らせも、止まれば静かに溜まるだけで、エラーは 1 件も出ない。
/// 気づくのは、買った方から問い合わせが来たときになる。
///
/// ⚠️ **1 実行 1 行にしない。** 行が無限に増え、掃除の仕組みが要る。
/// 見たいのは「最後にいつ成功したか」だけなので、種別ごとに 1 行を上書きする。
/// ⚠️ 個々の実行の記録が要るなら監査ログを見る。
model JobRun {
  /// 時計仕掛けの識別子（`issue-entitlements` など）。
  jobKey          String    @id @map("job_key")
  lastStartedAt   DateTime? @map("last_started_at") @db.Timestamptz(6)
  /// ⚠️ **成功と失敗を別の列で持つ。** 1 列にすると、失敗が上書きした
  /// 瞬間に「最後にいつ成功したか」が失われる。
  lastSucceededAt DateTime? @map("last_succeeded_at") @db.Timestamptz(6)
  lastFailedAt    DateTime? @map("last_failed_at") @db.Timestamptz(6)
  /// `succeeded` / `failed`。⚠️ CHECK で縛っている。
  lastOutcome     String?   @map("last_outcome")
  /// 直近の失敗の分類。⚠️ 例外の中身をそのまま入れない。
  lastErrorCode   String?   @map("last_error_code")
  /// 直近の成功で処理した件数。⚠️ 運用の目安であって、正確な累計ではない。
  lastPickedCount Int?      @map("last_picked_count")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("job_runs")
}

/// アカウント単位の申し送り（実運営 指示書 P1-1）。
///
/// ⚠️ **注文単位のメモ（`OrderNote`）とは別。** あちらは「この注文で何が
/// あったか」、こちらは「この方について何を知っておくべきか」。片方に寄せると、
/// 注文をまたぐ事情がどの注文にも属さないまま行き場を失う。
model AccountNote {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  /// 書いた運営スタッフ。⚠️ 氏名やメールではなくアカウントIDで持つ。
  authorAccountId String   @map("author_account_id") @db.Uuid
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation("AccountNoteSubject", fields: [accountId], references: [id], onDelete: Restrict)
  author  Account @relation("AccountNoteAuthor", fields: [authorAccountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@map("account_notes")
}

/// ご連絡先の変更申請（実運営 指示書 P1-1）。
///
/// ⚠️ **ここでアドレスは変わらない。** 認証の正は認証基盤側にあり、こちらが
/// 持つのは照合用の値だけ（`UD-503`）。この表が受け持つのは「申し出があった」
/// 「本人確認をした」「向こうで変えた」の 3 つの記録。
///
/// ⚠️ **本人確認を飛ばして `completed` にできない**（CHECK で縛る）。飛ばされた
/// ことは、乗っ取られるまで誰にも分からない。
///
/// ⚠️ 決着していない申請は、同じ方について 1 件まで（部分 UNIQUE 索引）。
/// Prisma では条件付き索引を書けないため、手書きのマイグレーション側にだけ存在する。
model EmailChangeRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  accountId            String    @map("account_id") @db.Uuid
  /// ⚠️ 伏せた表記。**ここから元へは戻せない。**
  requestedMaskedEmail String    @map("requested_masked_email")
  /// ⚠️ 鍵付きハッシュ。突き合わせにだけ使う。
  requestedEmailHash   String    @map("requested_email_hash")
  /// requested / identity_verified / completed / rejected
  status               String    @default("requested")
  /// ⚠️ 自由文にしない。何をしたのか分からない記録が並ぶ。
  verificationMethod   String?   @map("verification_method")
  verifiedByAccountId  String?   @map("verified_by_account_id") @db.Uuid
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz(6)
  settledByAccountId   String?   @map("settled_by_account_id") @db.Uuid
  settledAt            DateTime? @map("settled_at") @db.Timestamptz(6)
  note                 String?
  openedByAccountId    String    @map("opened_by_account_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account    Account  @relation("EmailChangeSubject", fields: [accountId], references: [id], onDelete: Restrict)
  openedBy   Account  @relation("EmailChangeOpener", fields: [openedByAccountId], references: [id], onDelete: Restrict)
  verifiedBy Account? @relation("EmailChangeVerifier", fields: [verifiedByAccountId], references: [id], onDelete: Restrict)
  settledBy  Account? @relation("EmailChangeSettler", fields: [settledByAccountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@map("email_change_requests")
}

/// 作家さまのプロフィール（実運営 指示書 P1-2）。
///
/// ⚠️ **表示名（`accounts.display_name`）とは別の表。** あちらは一意である
/// 必要がある（なりすまし防止・`UD-102`）。こちらは紹介文や画像で、一意性とは
/// 関係がない。混ぜると、紹介文を直すたびに一意性の検査が走る。
///
/// ⚠️ **すべて任意。** 埋めないと売れない作りにすると、作りたい人が最初の
/// 一歩で止まる。
model CreatorProfile {
  accountId     String   @id @map("account_id") @db.Uuid
  /// 屋号・ショップ名。⚠️ **一意ではない**（表示名がその役目を持つ）。
  shopName      String?  @map("shop_name")
  /// 紹介文。⚠️ HTML は保存の時点で断る（アプリ側で検証）。
  bio           String?
  /// SNS・Web サイト。⚠️ `https` のものだけ（アプリ側で検証）。
  /// 形は `[{ label, url }]`。件数の上限は CHECK で縛る。
  links         Json     @default("[]")
  /// 画像の保管庫の鍵。⚠️ URL ではなく鍵で持つ（保管庫を替えられるように）。
  iconKey       String?  @map("icon_key")
  coverKey      String?  @map("cover_key")
  /// インボイス（適格請求書発行事業者）の登録番号。
  /// ⚠️ **形だけを確かめる**（`T` + 13 桁）。実在は国税庁の公表サイトでしか
  /// 分からず、こちらでは確かめられない。確認済みと表示しない。
  invoiceNumber String?  @map("invoice_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

/// 作家さまのお振込先（P1-3・`UD-124` 決定 2026-08-21）。
///
/// ⚠️ **本人確認書類は取らない。** 口座情報の確認をもって足りるとする決定。
/// 書類の画像もマイナンバーも持たない。**持たないと決めたものは列を作らない。**
///
/// ⚠️ **作家さま 1 人につき 1 件。** 主キーをアカウントIDにしてある。
/// 「どちらへ振り込むか」を人が選ぶ形にすると、選び間違いが送金の間違いになる。
model CreatorPayoutAccount {
  creatorAccountId        String   @id @map("creator_account_id") @db.Uuid
  bankName                String   @map("bank_name")
  branchName              String   @map("branch_name")
  /// ordinary / checking。⚠️ CHECK で縛る（振込依頼書に載る値）。
  accountType             String   @map("account_type")
  /// 口座番号（包んだもの）。⚠️ **平文の列は無い。**
  accountNumberCiphertext String   @map("account_number_ciphertext")
  accountNumberNonce      String   @map("account_number_nonce")
  accountNumberAuthTag    String   @map("account_number_auth_tag")
  keyVersion              String   @map("key_version")
  /// 画面用（`***4567`）。⚠️ ここから元へは戻せない。
  maskedAccountNumber     String   @map("masked_account_number")
  accountHolderKana       String   @map("account_holder_kana")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// ⚠️ お振込先が残っているあいだ、アカウントは消せない（Restrict）。
  creator Account @relation("CreatorPayoutAccount", fields: [creatorAccountId], references: [id], onDelete: Restrict)

  @@map("creator_payout_accounts")
}

/// 運営への知らせの設定（`UD-1102` の一部・2026-08-22）。
///
/// ⚠️ **環境ごとに 1 件。** staging と production で宛先が違う。1 件に
/// まとめると、試したつもりの知らせが本番の担当者へ飛ぶ。
///
/// ⚠️ **外部の受け口の URL は包んで持つ。** URL 自体が合言葉である
/// （Slack の受け口などがそう）。**平文の列は無い。**
///
/// ⚠️ CHECK 制約（環境・色・間隔の範囲・包みの揃い・宛先の数）は
/// 手書きのマイグレーション `20260822000000_operations_alerts` にある。
model OperationsAlertSettings {
  environment        String    @id
  enabled            Boolean   @default(false)
  /// warning / checking ではなく warning / critical。⚠️ CHECK で縛る。
  minSeverity        String    @default("critical") @map("min_severity")
  /// 同じ状態が続くときの間隔（分）。⚠️ 15〜1440 を CHECK で縛る。
  repeatAfterMinutes Int       @default(240) @map("repeat_after_minutes")
  /// 運営の業務用アドレス。⚠️ **お客さまのアドレスを入れる場所ではない。**
  emailRecipients    String[]  @default([]) @map("email_recipients")
  webhookCiphertext  String?   @map("webhook_ciphertext")
  webhookNonce       String?   @map("webhook_nonce")
  webhookAuthTag     String?   @map("webhook_auth_tag")
  webhookKeyVersion  String?   @map("webhook_key_version")
  /// 画面用。⚠️ ホスト名まで（経路は合言葉なので出さない）。
  webhookHost        String?   @map("webhook_host")
  /// 抑制の判断材料。⚠️ 設定の保存では触らない。
  lastNotifiedAt     DateTime? @map("last_notified_at") @db.Timestamptz(6)
  lastSeverity       String?   @map("last_severity")
  lastFingerprint    String?   @map("last_fingerprint")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("operations_alert_settings")
}

/// 返金の申請と審査（方針整理 2026-08-22）。
///
/// ⚠️ **既存の `Refund` を置き換えない。** あちらは決済事業者への返金
/// そのものの記録で、こちらはその手前の手続きである。
///
/// ⚠️ **同じ注文に、決着していない申請を 2 つ作れない**（部分 UNIQUE
/// 索引 `refund_requests_open_per_order`）。作れると、2 人が別々に承認して
/// **二重返金**になる。Prisma では条件付き索引を書けないため、
/// **手書きのマイグレーション側にだけ存在する**。
///
/// ⚠️ CHECK 制約（状態・区分・扱い・金額・二重承認の別人・却下の理由・
/// 実行済みの返金行）は `20260822010000_refund_requests` にある。
model RefundRequest {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  status                 String   @default("submitted")
  reason                 String
  /// ⚠️ 理由から決まる。人が選び直せない。
  category               String
  /// 運営の書き込み。⚠️ 購入者には見せない。
  note                   String?
  /// 購入者が書いた申し出。⚠️ 文字として扱う（HTML にしない）。
  buyerStatement         String?  @map("buyer_statement")
  amount                 Int
  isFullRefund           Boolean  @map("is_full_refund")
  /// `revoke` / `keep`。⚠️ 一部返金では運営が承認のときに指定する。
  entitlementDisposition String   @default("keep") @map("entitlement_disposition")
  requestedByAccountId   String?  @map("requested_by_account_id") @db.Uuid
  reviewedByAccountId    String?  @map("reviewed_by_account_id") @db.Uuid
  approvedByAccountId    String?  @map("approved_by_account_id") @db.Uuid
  dualApprovalRequired   Boolean  @default(false) @map("dual_approval_required")
  /// 原則対象外を、運営が例外として通したか。
  approvedAsException    Boolean  @default(false) @map("approved_as_exception")
  rejectionNote          String?  @map("rejection_note")
  /// 実行してできた返金の行。⚠️ 実行するまで NULL。
  refundId               String?  @map("refund_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy Account?              @relation("RefundRequestRequester", fields: [requestedByAccountId], references: [id], onDelete: SetNull)
  reviewedBy  Account?              @relation("RefundRequestReviewer", fields: [reviewedByAccountId], references: [id], onDelete: SetNull)
  approvedBy  Account?              @relation("RefundRequestApprover", fields: [approvedByAccountId], references: [id], onDelete: SetNull)
  events      RefundRequestEvent[]
  inquiry     CreatorRefundInquiry?
  refunds     Refund[]              @relation("RefundFromRequest")

  @@index([status, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("refund_requests")
}

/// 返金申請の証跡（追記のみ）。
///
/// ⚠️ **監査ログと別に持つ。** あちらは運営の操作全般で、こちらは
/// **この申請に何が起きたか**を時系列で読むためのもの。
///
/// ⚠️ **DB のトリガーが UPDATE / DELETE を拒む。** アプリに口を作らない
/// だけでは足りない——アプリを通さない書き込みも止める。
model RefundRequestEvent {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  action         String
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  /// ⚠️ **金額と符号まで。** 購入者の申し出の本文をここへ写さない。
  summary        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   Account?      @relation("RefundRequestEventActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("refund_request_events")
}

/// 作家さまへの事実確認（方針整理 2026-08-22）。
///
/// ⚠️ **回答は任意である。** 期限が来れば運営だけで進める。「答えないと
/// 返金できない」にすると、答えない作家さまがいるだけで購入者が待たされる。
///
/// ⚠️ **申請 1 件につき 1 回。** 何度も聞き直す形にしない（期限が意味を失う）。
model CreatorRefundInquiry {
  id               String    @id @default(uuid()) @db.Uuid
  requestId        String    @unique @map("request_id") @db.Uuid
  creatorAccountId String    @map("creator_account_id") @db.Uuid
  askedAt          DateTime  @map("asked_at") @db.Timestamptz(6)
  dueAt            DateTime  @map("due_at") @db.Timestamptz(6)
  answeredAt       DateTime? @map("answered_at") @db.Timestamptz(6)
  /// 作家さまの回答。⚠️ 文字として扱う。
  answer           String?
  /// 添付の保管庫の鍵。⚠️ URL ではなく鍵で持つ。
  attachmentKeys   String[]  @default([]) @map("attachment_keys")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  creator Account       @relation("CreatorRefundInquiry", fields: [creatorAccountId], references: [id], onDelete: Restrict)

  @@index([creatorAccountId, dueAt])
  @@map("creator_refund_inquiries")
}

/// 作家さまからの回収待ち（方針整理 2026-08-22）。
///
/// ⚠️ **これは請求書ではない。** 記録であって、取り立ての仕組みではない。
///
/// ⚠️ **既存の繰越（`carriedOutAmount`）を置き換えない。** あちらは
/// 「精算 1 件のなかで引ききれなかった額」で、こちらは
/// **「精算をまたいで残っている額」**である。
///
/// ⚠️ **同じ注文で 2 行作れない**（UNIQUE）。作れると、1 回の返金で
/// 二重に取り立てることになる。
model CreatorReceivable {
  id                 String    @id @default(uuid()) @db.Uuid
  creatorAccountId   String    @map("creator_account_id") @db.Uuid
  orderId            String    @unique @map("order_id") @db.Uuid
  /// ⚠️ **正の数**で持つ。符号は使う側が付ける。
  amount             Int
  status             String    @default("outstanding")
  settledByAccountId String?   @map("settled_by_account_id") @db.Uuid
  settledAt          DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator   Account  @relation("CreatorReceivable", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  settledBy Account? @relation("CreatorReceivableSettler", fields: [settledByAccountId], references: [id], onDelete: SetNull)

  @@index([creatorAccountId, status])
  @@map("creator_receivables")
}
