// 千ノ国NFTマーケット — データベーススキーマ
//
// 設計の根拠は docs/DATABASE_DESIGN.md を参照。
//
// ⚠️ Phase 1 では **スキーマ定義と Prisma Client の生成のみ**を行う。
//    マイグレーションの生成・適用は行わない（本番DBへ接続しない）。
//
// この設計で最も重要なのは、冪等性を「アプリの if 文」ではなく
// **DB の一意制約と条件付き UPDATE** で担保している点。
// 競合状態ではアプリのチェックは破れるが、DB の制約は破れない。

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// アカウント
// ============================================================================

enum AccountRole {
  buyer
  operator
  auditor
}

enum AccountStatus {
  active
  suspended
}

/// 認証の正は Supabase Auth 側にあり、本テーブルは参照と業務属性のみを持つ。
/// パスワードや資格情報は一切保持しない。
model Account {
  id           String        @id @default(uuid()) @db.Uuid
  authProvider String        @map("auth_provider")
  authSubject  String        @map("auth_subject")
  /// 照合用のハッシュ。平文のメールアドレスは保持しない（UD-503）。
  emailHash    String?       @map("email_hash")
  displayName  String?       @map("display_name")
  /// ロールの正は本テーブル。JWT のクレームからは読まない（権限昇格を防ぐ）。
  role         AccountRole   @default(buyer)
  status       AccountStatus @default(active)
  /// 人に権限を配れるか（UD-803 決定 2026-08-18）。
  /// ⚠️ 役割とは別の軸。役割は「作品や注文に何ができるか」、
  /// こちらは「人事を触れるか」。4 つ目の役割にすると、operator に許した
  /// 操作をすべて写す必要が生まれ、写し忘れが静かに残る。
  /// ⚠️ CHECK で operator に限っている（accounts_owner_is_operator）。
  isOwner      Boolean       @default(false) @map("is_owner")
  /// 運営スタッフの業務用アドレス。**購入者の行には入らない**（CHECK で縛る）。
  /// ⚠️ UD-503（購入者のメールを平文で持たない）は維持したまま、
  /// オーナーが自分で入力したスタッフの連絡先だけを持つ。
  staffEmail   String?       @map("staff_email")

  /// 共通顧客ID。**発行元は代理店システムのみ**で、本システムは受け取るだけ。
  /// ⚠️ 主キーにしない。外部が発行した値を主キーにすると、
  /// 相手の都合で自分のデータが壊れる。人物識別は accounts.id のまま。
  /// ⚠️ UNIQUE にしない。同一人物が別の認証手段で 2 アカウントを持つと、
  /// どちらも同じ common_user_id へ解決されうる。UNIQUE にすると
  /// 「正しい解決」が保存できずに落ちる。
  commonUserId        String?   @map("common_user_id")
  commonUserStatus    String    @default("UNRESOLVED") @map("common_user_status")
  commonUserLinkedAt  DateTime? @map("common_user_linked_at") @db.Timestamptz(6)
  /// 失敗の理由。⚠️ 応答本文をそのまま入れない（個人情報が混ざりうる）。
  commonUserLastError String?   @map("common_user_last_error")
  /// 再試行の状態。指示書は 4 列だが、バックオフには回数と次回時刻が要る。
  commonUserAttemptCount  Int       @default(0) @map("common_user_attempt_count")
  commonUserNextAttemptAt DateTime? @map("common_user_next_attempt_at") @db.Timestamptz(6)

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders               Order[]
  /// 自分が出品者として受けた注文（1 注文 1 クリエイター）。
  createdOrders        Order[]              @relation("OrderCreator")
  createdOrderLines    OrderLine[]          @relation("OrderLineCreator")
  entitlements         Entitlement[]        @relation("EntitlementPurchaser")
  claimedEntitlements  Entitlement[]        @relation("EntitlementClaimer")
  auditLogs            AuditLog[]
  idempotencyKeys      IdempotencyKey[]
  createdArtworks      Artwork[]            @relation("ArtworkCreator")
  sentInvitations      StaffInvitation[]    @relation("StaffInvitationInviter")
  acceptedInvitations  StaffInvitation[]    @relation("StaffInvitationAcceptor")
  integrationSettings  IntegrationSetting[] @relation("IntegrationSettingEditor")
  integrationSecrets   IntegrationSecret[]  @relation("IntegrationSecretCreator")
  integrationChecks    IntegrationConnectionCheck[] @relation("IntegrationCheckExecutor")

  @@unique([authProvider, authSubject])
  @@index([commonUserStatus, commonUserNextAttemptAt])
  @@index([commonUserId])
  @@map("accounts")
}

/// スタッフの招待（UD-803 決定 2026-08-18）。
///
/// ⚠️ **招待リンクのトークンを持たない。** 受諾は「そのアドレスで
/// ログインできたこと」で判定する。トークンを配ると、転送・流出した
/// リンクを拾った別人が権限を得られる。受信箱に届く経路そのものを
/// 本人確認に使い、鍵を増やさない。
model StaffInvitation {
  id                  String      @id @default(uuid()) @db.Uuid
  /// 招待した宛先。オーナーが自分で入力した値をそのまま残す。
  email               String
  /// 受諾したときに付く役割。buyer は CHECK で弾く。
  role                AccountRole
  /// pending / accepted / revoked / expired
  status              String      @default("pending")
  invitedByAccountId  String      @map("invited_by_account_id") @db.Uuid
  acceptedByAccountId String?     @map("accepted_by_account_id") @db.Uuid
  expiresAt           DateTime    @map("expires_at") @db.Timestamptz(6)
  acceptedAt          DateTime?   @map("accepted_at") @db.Timestamptz(6)
  /// 取り消し・期限切れで閉じた時刻。
  closedAt            DateTime?   @map("closed_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy  Account  @relation("StaffInvitationInviter", fields: [invitedByAccountId], references: [id])
  /// ⚠️ 受けた人のアカウントは、招待が残っているあいだ消せない（Restrict）。
  /// SetNull にすると「誰かが受けたが、誰かは分からない」行が残る。
  acceptedBy Account? @relation("StaffInvitationAcceptor", fields: [acceptedByAccountId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([invitedByAccountId, createdAt])
  @@map("staff_invitations")
}

/// 外部連携の公開してよい設定（指示書 §5）。
///
/// ⚠️ **秘密の列を作らない。** CHECK では「秘密が入っていないこと」を
/// 表現できない。列そのものを用意しないことでしか担保できない。
model IntegrationSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  /// ovew_wallet / payment / storage / auth
  service            String
  /// staging / production。⚠️ `APP_ENV` とは別物（どの環境向けの設定か）。
  environment        String
  endpointUrl        String?  @map("endpoint_url")
  /// 署名に使う鍵の識別子。⚠️ **秘密ではない。** 鍵そのものは
  /// `integration_secrets` に暗号化して置く。ここに置くのは
  /// 「どの鍵か」を相手へ伝える名前で、署名ヘッダにそのまま載る値。
  keyId              String?  @map("key_id")
  apiVersion         String?  @map("api_version")
  /// 決済にだけ意味のある欄。支払い完了・中止で購入者を戻す先。
  /// ⚠️ 成功URLには `{ORDER_ID}` を含める（どの注文の結果か画面が判断できない）。
  checkoutSuccessUrl String?  @map("checkout_success_url")
  checkoutCancelUrl  String?  @map("checkout_cancel_url")
  /// プラットフォーム手数料（ベーシスポイント）。
  /// ⚠️ **0 は「無料」ではなく「販売設定が未完了」。** 0 のままでは
  /// 支払い口を作らせない。「無料で売れる」より「売れない」ほうが
  /// 取り返しがつくため。
  platformFeeRateBps Int      @default(0) @map("platform_fee_rate_bps")
  timeoutMs          Int      @default(10000) @map("timeout_ms")
  maxAttempts        Int      @default(5) @map("max_attempts")
  enabled            Boolean  @default(false)
  /// 楽観ロック。古い画面からの上書きを弾く（指示書 §12）。
  rowVersion         Int      @default(1) @map("row_version")
  updatedByAccountId String?  @map("updated_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy Account? @relation("IntegrationSettingEditor", fields: [updatedByAccountId], references: [id], onDelete: Restrict)

  @@unique([service, environment])
  @@map("integration_settings")
}

/// 暗号化した資格情報（指示書 §6）。
///
/// ⚠️ **平文を戻す経路を作らない。** 復号してよいのは送信アダプタだけで、
/// 一覧や詳細から呼べる形にしない。
model IntegrationSecret {
  id                 String    @id @default(uuid()) @db.Uuid
  service            String
  environment        String
  /// 同じサービスで複数持てるようにする（鍵ID と 署名鍵 など）。
  purpose            String
  ciphertext         String
  nonce              String
  authTag            String    @map("auth_tag")
  /// どの暗号鍵で包んだか。鍵の交換に備えて必ず持つ。
  keyVersion         String    @map("key_version")
  /// 画面での見分け用。⚠️ **平文の一部**。DB 側で 4 文字に縛ってある。
  lastFour           String    @default("") @map("last_four")
  /// pending / active / retired
  status             String    @default("pending")
  createdByAccountId String?   @map("created_by_account_id") @db.Uuid
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy Account?                     @relation("IntegrationSecretCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  checks    IntegrationConnectionCheck[]

  @@index([service, environment, status])
  @@map("integration_secrets")
}

/// 接続テストの記録（指示書 §9）。
///
/// ⚠️ **外部の生の応答本文を入れない。** 秘匿値が混ざりうる。
/// 残すのは分類コードだけ。
model IntegrationConnectionCheck {
  id                  String   @id @default(uuid()) @db.Uuid
  service             String
  environment         String
  /// 何を確かめたか。いまは到達性のみ（`reachability`）。
  /// ⚠️ 資格情報が正しいかどうかは、この確認では分からない（要決定 06）。
  kind                String
  succeeded           Boolean
  failureCode         String?  @map("failure_code")
  /// 相手が返した HTTP の状態コード。⚠️ 応答本文は保存しない。
  httpStatus          Int?     @map("http_status")
  durationMs          Int      @map("duration_ms")
  secretId            String?  @map("secret_id") @db.Uuid
  executedByAccountId String?  @map("executed_by_account_id") @db.Uuid
  correlationId       String?  @map("correlation_id")
  executedAt          DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)

  secret     IntegrationSecret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  executedBy Account?           @relation("IntegrationCheckExecutor", fields: [executedByAccountId], references: [id], onDelete: Restrict)

  @@index([service, environment, executedAt(sort: Desc)])
  @@map("integration_connection_checks")
}

// ============================================================================
// 作品と出品
// ============================================================================

enum ArtworkStatus {
  draft
  published
  archived
}

/// 在庫（発行上限）の正。
/// reservedCount + issuedCount <= maxSupply を DB の CHECK 制約で担保する。
/// アプリ側の行ロック検証と二重に持つことで、バグがあってもオーバーセルさせない。
/// CHECK 制約は Prisma のスキーマ言語で表現できないため、
/// マイグレーション生成時に手書きで追加する（DATABASE_DESIGN.md §3.2）。
model Artwork {
  id            String        @id @default(uuid()) @db.Uuid
  /// 登録した人（UD-102 決定変更 2026-08-18: 作家の自己出品を行う）。
  /// ⚠️ NULL を許さない。持ち主の決まらない作品を作ると、誰が触ってよいかを
  /// 判定できない行が生まれる。判定できない行は「とりあえず通す」に倒れやすい。
  /// ⚠️ ON DELETE を CASCADE にしない。アカウントを消したときに、
  /// 売れた作品まで消えると注文の履歴と食い違う。Restrict にして、
  /// 「作品を持ったままのアカウントは消せない」を DB に守らせる。
  creatorAccountId String     @map("creator_account_id") @db.Uuid
  creator       Account       @relation("ArtworkCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  slug          String        @unique
  title         String
  description   String        @default("")
  /// ストレージ上のキー。公開URLは実行時に解決する（保存先は Cloudflare R2、UD-508）。
  /// アップロード時にランダム生成する。**利用者が送ったファイル名は使わない。**
  imageKey         String?    @map("image_key")
  /// サーバー側で中身を検査して判定した MIME タイプ。拡張子は信用しない。
  imageContentType String?    @map("image_content_type")
  imageByteSize    Int?       @map("image_byte_size")
  /// 画像の内容ハッシュ（`sha256:<hex>`）。保存時に**中身から**計算する。
  /// Wallet の Holding 表示情報の同一性確認に使う（PR-NW04 §23）。
  /// ⚠️ ファイル名や URL から導出しない。差し替えを検出できなくなる。
  imageHash        String?    @map("image_hash")
  maxSupply     Int           @map("max_supply")
  /// 決済待ちの注文が押さえている数。
  reservedCount Int           @default(0) @map("reserved_count")
  /// 受取権として発行済みの数。
  issuedCount   Int           @default(0) @map("issued_count")
  status        ArtworkStatus @default(draft)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  listings     Listing[]
  orderLines   OrderLine[]
  entitlements Entitlement[]
  reservations InventoryReservation[]

  @@index([status])
  /// 出品者が「自分の作品」を引くための索引。一覧のたびに全件走査させない。
  @@index([creatorAccountId, createdAt])
  @@map("artworks")
}

enum ListingStatus {
  draft
  scheduled
  active
  suspended
  ended
}

model Listing {
  id                  String        @id @default(uuid()) @db.Uuid
  artworkId           String        @map("artwork_id") @db.Uuid
  /// 最小通貨単位の整数。金額に浮動小数点を使わない。
  priceAmount         Int           @map("price_amount")
  priceCurrency       String        @map("price_currency") @db.Char(3)
  maxQuantityPerOrder Int           @default(1) @map("max_quantity_per_order")
  status              ListingStatus @default(draft)
  startsAt            DateTime?     @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?     @map("ends_at") @db.Timestamptz(6)
  /// 一覧での並び順。小さいほど前に出る。
  displayOrder        Int           @default(0) @map("display_order")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  artwork      Artwork                @relation(fields: [artworkId], references: [id])
  orderLines   OrderLine[]
  reservations InventoryReservation[]

  @@index([artworkId])
  @@index([status, startsAt, endsAt])
  @@index([displayOrder])
  @@map("listings")
}

// ============================================================================
// 注文と決済
// ============================================================================

/// 注文の進み具合（決済 Phase P0・P1・指示書 §7）。
///
/// ⚠️ `failed` と `refunded` は**新しい注文では使わない**。
/// 決済の失敗は `payment_status`、返金は `refund_status` が持つ。
/// 列挙型から消すと過去の行が読めなくなるため、値だけ残してある。
/// 新しい注文がそこへ遷移しないことは、ドメインの遷移表が守る。
enum OrderStatus {
  pending
  checkout_created
  paid
  expired
  cancelled
  failed
  refunded
}

/// 注文が生まれた経路。
///
/// ⚠️ **`entitlements.order_id` の NOT NULL を緩めないために存在する。**
/// staging の動作確認では「注文の無い受取権」を作りたくなるが、
/// 列を NULL 許容へ変えると、その穴は**本番の経路にも開く**。
/// 代わりに Fixture 側で本物の Order / OrderLine を作り、
/// この列で出自を区別する（PR-NW04 §7）。
enum OrderSource {
  /// 通常の購入。
  PURCHASE
  /// staging 動作確認用の Fixture が作ったもの。決済は一切伴わない。
  STAGING_FIXTURE
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  /// 人が読み上げ、問い合わせで使う番号。⚠️ 参照の正は `id` のまま。
  orderNumber    String      @unique @map("order_number")
  accountId      String      @map("account_id") @db.Uuid
  /// 共通顧客ID。まだ解決できていない購入者があるため NULL を許す。
  commonUserId   String?     @map("common_user_id")
  /// ⚠️ 1 注文 1 クリエイター（指示書 §3-4）。明細と必ず一致させる。
  creatorAccountId String    @map("creator_account_id") @db.Uuid
  status         OrderStatus @default(pending)
  /// 出自。既定は購入。Fixture だけが `STAGING_FIXTURE` を入れる。
  source         OrderSource @default(PURCHASE)
  /// 商品の税込価格（単価 × 数量）。
  subtotalAmount Int         @map("subtotal_amount")
  /// 値引額。⚠️ 今回は常に 0。列と計算だけ先に用意してある。
  discountAmount Int         @default(0) @map("discount_amount")
  /// 購入者が支払う額。`subtotal - discount` と CHECK 制約で一致させる。
  totalAmount    Int         @map("total_amount")
  totalCurrency  String      @map("total_currency") @db.Char(3)
  /// 注文時点の手数料率。⚠️ **bps（1/100 %）の整数**。
  /// 率を小数で持つと、金額に掛けた瞬間に誤差が入る。
  platformFeeRateBps Int     @default(0) @map("platform_fee_rate_bps")
  platformFeeAmount  Int     @default(0) @map("platform_fee_amount")
  /// クリエイター配分額。`total - platformFee` と CHECK 制約で一致させる。
  creatorAmount      Int     @map("creator_amount")
  /// ⚠️ 4 つの状態を 1 本に詰め込まない（指示書 §7）。
  /// 「決済は成功したが付与に失敗した」を表せなくなる。
  paymentStatus     String   @default("not_started") @map("payment_status")
  fulfillmentStatus String   @default("not_started") @map("fulfillment_status")
  refundStatus      String   @default("none") @map("refund_status")
  /// 二重注文を防ぐ冪等キー。アプリの重複チェックではなく UNIQUE 制約で担保する。
  idempotencyKey String      @map("idempotency_key")
  /// 在庫の仮引当の期限。過ぎたらワーカーが解放する。
  reservedUntil  DateTime?   @map("reserved_until") @db.Timestamptz(6)
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  account       Account                @relation(fields: [accountId], references: [id])
  creator       Account                @relation("OrderCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  lines         OrderLine[]
  payments      Payment[]
  entitlements  Entitlement[]
  reservations  InventoryReservation[]
  webhookEvents WebhookEvent[]

  /// ⚠️ 冪等キーの一意性はここが守る（指示書 §4.5）。
  /// アプリの重複チェックではなく、DB の制約で担保する。
  @@unique([accountId, idempotencyKey])
  @@index([status, reservedUntil])
  @@index([accountId, createdAt])
  @@index([creatorAccountId, createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)])
  /// Fixture 由来の行を洗い出して掃除するため。
  @@index([source, createdAt])
  @@map("orders")
}

/// 注文時点の作品名と価格をスナップショットする。
/// マスタを後から変更しても、過去の取引記録が書き換わらないようにするため。
model OrderLine {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  listingId            String   @map("listing_id") @db.Uuid
  artworkId            String   @map("artwork_id") @db.Uuid
  /// ⚠️ 出品者。注文時点のものを持つ。作品の持ち主が変わっても動かさない。
  creatorAccountId     String   @map("creator_account_id") @db.Uuid
  artworkTitleSnapshot String   @map("artwork_title_snapshot")
  unitPriceAmount      Int      @map("unit_price_amount")
  unitPriceCurrency    String   @map("unit_price_currency") @db.Char(3)
  quantity             Int
  /// 単価 × 数量。CHECK 制約で一致を守る。
  totalAmount          Int      @map("total_amount")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order        Order         @relation(fields: [orderId], references: [id])
  listing      Listing       @relation(fields: [listingId], references: [id])
  artwork      Artwork       @relation(fields: [artworkId], references: [id])
  creator      Account       @relation("OrderLineCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)
  entitlements Entitlement[]

  /// ⚠️ **MVP は 1 注文 1 明細**（指示書 §5.2）。
  /// `order_id` だけの UNIQUE が「明細は 1 本まで」を DB に守らせる。
  @@unique([orderId], map: "order_lines_single_item_per_order")
  @@map("order_lines")
}

/// 在庫の仮引当（決済 Phase P0・P1・指示書 §5.3）。
///
/// ⚠️ **在庫を減らす前の「押さえ」を、注文とは別の行として持つ。**
/// 注文の列に期限だけ書く方式だと、「解放したか」を注文の状態から
/// 推測することになり、二重解放と解放漏れのどちらも静かに起こる。
/// 行にして状態を持たせると、解放は「reserved の行を released にする」
/// という 1 回しか成立しない操作になる。
///
/// ⚠️ 部分 UNIQUE 索引 `inventory_reservations_one_active_per_order`
/// （`WHERE status = 'reserved'`）が「1 注文に有効な予約は 1 件」を守る。
/// Prisma のスキーマでは条件付き索引を書けないため、
/// **手書きのマイグレーション側にだけ存在する**。消さないこと。
model InventoryReservation {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  listingId  String    @map("listing_id") @db.Uuid
  artworkId  String    @map("artwork_id") @db.Uuid
  quantity   Int
  /// `reserved` / `consumed` / `released`。CHECK 制約で縛る。
  status     String    @default("reserved")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Restrict)

  /// 期限切れの掃き出しで使う。全件走査させない。
  @@index([status, expiresAt], map: "inventory_reservations_expiry_idx")
  @@map("inventory_reservations")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  /// 支払い口の期限切れ・利用者の取消。⚠️ `failed`（カード拒否など）と分ける。
  cancelled
  refunded
  partially_refunded
}

/// 決済の真の状態は常に外部の決済事業者側にある。
/// 本テーブルは Webhook で受け取った事実の写像であり、
/// 本システム側から状態を推測して進めない。
model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  provider           String
  /// Stripe Checkout Session（Phase P2 で埋める）。
  providerSessionRef String?       @map("provider_session_ref")
  /// Stripe Payment Intent（Phase P2 で埋める）。
  providerPaymentRef String?       @map("provider_payment_ref")
  /// Stripe Charge（Phase P2 で埋める）。
  providerChargeRef  String?       @map("provider_charge_ref")
  /// 決済事業者へ渡す冪等キー。⚠️ 業務の冪等キーとは別物。
  providerIdempotencyKey String?   @map("provider_idempotency_key")
  status             PaymentStatus @default(pending)
  amount             Int
  currency           String        @db.Char(3)
  amountRefunded     Int           @default(0) @map("amount_refunded")
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// 支払い口が閉じる時刻。⚠️ お取り置きの期限を超えない。
  expiresAt          DateTime?     @map("expires_at") @db.Timestamptz(6)
  /// 利用者を送る先。⚠️ **管理画面へ出さない。** これを持つ人は誰でも
  /// その注文を支払える。運用に要るのは識別子までで、URL は要らない。
  checkoutUrl        String?       @map("checkout_url")
  failureCode        String?       @map("failure_code")
  /// ⚠️ 外部の応答本文をそのまま入れない。運用が読むための短い要約だけ。
  failureMessageSafe String?       @map("failure_message_safe")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order          @relation(fields: [orderId], references: [id])
  webhookEvents WebhookEvent[]

  /// ⚠️ 試行ごとに 1 行。失敗した行も消さない（決済 Phase P2 の決定 B）。
  /// 「何回目で何が起きたか」を説明できないと、問い合わせに答えられない。
  ///
  /// ⚠️ **1 注文に成功は 1 件だけ**という制約は、Prisma では書けない
  /// 部分 UNIQUE 索引（`WHERE status = 'succeeded'`）で守っている。
  /// 手書きのマイグレーション側にだけ存在する。消さないこと。
  @@unique([provider, providerPaymentRef])
  @@index([orderId])
  @@index([orderId, createdAt(sort: Desc)], map: "payments_order_created_idx")
  @@map("payments")
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed
}

/// 外部 Webhook の受信記録。二重処理防止の中核。
///
/// 処理順序: 署名検証 → 本テーブルへ INSERT（一意制約違反なら既受信として即 200）
///           → 業務処理 → processedAt 更新
///
/// 本文（payload）は保存せず、ダイジェストのみ持つ。
/// 本文には個人情報・カード関連情報が含まれうるため。
model WebhookEvent {
  id            String             @id @default(uuid()) @db.Uuid
  provider      String
  /// 送信元が採番したイベントID。
  eventId       String             @map("event_id")
  eventType     String             @map("event_type")
  /// 固定した API バージョン。形が変わったことに後から気づくため。
  apiVersion    String?            @map("api_version")
  /// 本番モードの事象か。⚠️ 試験の知らせで本番の注文を確定させないため。
  livemode      Boolean?
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(6)
  status        WebhookEventStatus @default(received)
  attemptCount  Int                @default(0) @map("attempt_count")
  payloadDigest String             @map("payload_digest")
  /// 失敗理由の要約。秘匿値を含めない。
  errorSummary  String?            @map("error_summary")
  /// ⚠️ 事業者の符号をそのまま入れない。こちらで決めた安全な符号だけ。
  lastErrorCode String?            @map("last_error_code")
  orderId       String?            @map("order_id") @db.Uuid
  paymentId     String?            @map("payment_id") @db.Uuid

  /// ⚠️ `Restrict`。既定の `SetNull` にすると、注文を消したときに
  /// 受信の記録だけが親を失って残る。注文と決済のデータは消さない決まり
  /// （指示書 §9.3）なので、消そうとした時点で止める。
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// ⚠️ **本文の全体を保存しない**（指示書 §10）。残すのは digest だけ。
  /// カード情報・個人情報・秘密が混ざる余地を作らない。
  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([orderId, receivedAt(sort: Desc)], map: "webhook_events_order_idx")
  @@map("webhook_events")
}

// ============================================================================
// 受取権（本ドメインの中核）
// ============================================================================

enum EntitlementStatus {
  issued
  claimed
  expired
  revoked
}

/// 「1枚のトークンを受け取る権利」。
/// 数量Nの注文に対し **N 行**作成する。注文が数量を持つのではなく、
/// 注文がN個の受取権を生む、という粒度でモデル化している。
///
/// claimed への遷移は条件付き UPDATE（WHERE status = 'issued'）で行い、
/// 更新行数が 1 の場合のみ成功とする。同時 Claim でも 1 回しか成功しない。
model Entitlement {
  id                   String            @id @default(uuid()) @db.Uuid
  orderId              String            @map("order_id") @db.Uuid
  orderLineId          String            @map("order_line_id") @db.Uuid
  artworkId            String            @map("artwork_id") @db.Uuid
  /// 購入者。Claim の本人照合はこの値と認証アカウントの一致で行う。
  accountId            String            @map("account_id") @db.Uuid
  serialNo             Int               @map("serial_no")
  /// Claim トークンのハッシュ。**平文は保存しない。**
  claimTokenHash       String            @map("claim_token_hash")
  status               EntitlementStatus @default(issued)
  /// Claim 期限。null は無期限（UD-505 で未決定のため MVP は null）。
  expiresAt            DateTime?         @map("expires_at") @db.Timestamptz(6)
  claimedByAccountId   String?           @map("claimed_by_account_id") @db.Uuid
  claimedAt            DateTime?         @map("claimed_at") @db.Timestamptz(6)
  /// Wallet 経由で受け取った本人の `common_user_id`。
  /// ⚠️ 受取時点の値を**そのまま残す**。あとでマスタが変わっても遡って書き換えない。
  claimedByCommonUserId String?          @map("claimed_by_common_user_id")
  /// Wallet への配送状態。not_started / pending / delivered。
  /// ⚠️ `delivered` へ進めてよいのは、Wallet が 2xx を返し、
  ///    それが Holding の永続化を意味する場合のみ（PR-NW04 §21）。
  walletDeliveryStatus String            @default("not_started") @map("wallet_delivery_status")
  /// 配送が完了した時刻。`walletDeliveryStatus = 'delivered'` と必ず同時に入る。
  walletDeliveredAt    DateTime?         @map("wallet_delivered_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order           Order     @relation(fields: [orderId], references: [id])
  orderLine       OrderLine @relation(fields: [orderLineId], references: [id])
  artwork         Artwork   @relation(fields: [artworkId], references: [id])
  purchaser       Account   @relation("EntitlementPurchaser", fields: [accountId], references: [id])
  claimedByAccount Account? @relation("EntitlementClaimer", fields: [claimedByAccountId], references: [id])
  mintJob         MintJob?
  nftToken        NftToken?
  walletDeliveries WalletDeliveryOutbox[]

  /// 同一作品内でシリアル番号が重複しないことを物理的に担保する。
  @@unique([artworkId, serialNo])
  /// トークンの衝突を検出する。
  @@unique([claimTokenHash])
  @@index([accountId, status])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("entitlements")
}

// ============================================================================
// 発行（Mint）
// ============================================================================

enum MintJobStatus {
  queued
  processing
  succeeded
  failed
  cancelled
}

/// 発行ジョブ。ワーカーが FOR UPDATE SKIP LOCKED で排他取得する。
///
/// entitlementId の UNIQUE により、1つの受取権に対してジョブは 1 件しか作れない。
/// これが「1つの受取権から複数Mintできない」ことを担保する4層のうちの1つ。
///
/// ⚠️ **発行先チェーンの列を意図的に置いていない。**
///    マルチチェーン対応の要否が未決定（UD-512）で、チェーン選定（UD-501）と
///    同時に判断する。本テーブルに本番データが入るのは Phase 5 以降なので、
///    決定後に列を足しても安く済む（既存行の埋め戻しも自明）。
///    記録側の nft_tokens には chainRef があり、そちらは単一チェーン運用でも保持する。
model MintJob {
  id             String        @id @default(uuid()) @db.Uuid
  entitlementId  String        @unique @map("entitlement_id") @db.Uuid
  status         MintJobStatus @default(queued)
  attemptCount   Int           @default(0) @map("attempt_count")
  maxAttempts    Int           @default(5) @map("max_attempts")
  /// バックオフ後の実行予定時刻。
  nextAttemptAt  DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// processing 開始時刻。滞留の検出に使う。
  lockedAt       DateTime?     @map("locked_at") @db.Timestamptz(6)
  /// 外部Mint APIへ渡す冪等キー。受取権IDから決定論的に導出する。
  idempotencyKey String        @unique @map("idempotency_key")
  /// プロバイダ側の依頼識別子。状態問い合わせに使う。
  submissionRef  String?       @map("submission_ref")
  /// 失敗理由の分類コード。外部APIの生メッセージを入れない。
  lastErrorCode  String?       @map("last_error_code")
  /// 運用注記。processing 中の行を返金で取り消せない場合などに記録する。
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlement Entitlement @relation(fields: [entitlementId], references: [id])
  nftToken    NftToken?

  @@index([status, nextAttemptAt])
  @@map("mint_jobs")
}

/// 発行済みトークンへの参照。
///
/// entitlementId の UNIQUE が「1受取権1トークン」の最終的な担保。
/// 万一ジョブが2回実行されても、記録は1件しか作られない。
///
/// ⚠️ chainRef / contractRef / tokenRef / ownerRef は **不透明な文字列**にしてある。
///    チェーン仕様が未決定（UD-501）のため、EVM のアドレス形式などに固定しない。
///    決定後に CHECK 制約や正規化を追加する。
model NftToken {
  id            String   @id @default(uuid()) @db.Uuid
  entitlementId String   @unique @map("entitlement_id") @db.Uuid
  mintJobId     String   @unique @map("mint_job_id") @db.Uuid
  chainRef      String   @map("chain_ref")
  contractRef   String   @map("contract_ref")
  tokenRef      String   @map("token_ref")
  txRef         String?  @map("tx_ref")
  /// 所有者参照。カストディ方式が未決定（UD-502）のため不透明参照。
  ownerRef      String   @map("owner_ref")
  metadataUri   String?  @map("metadata_uri")
  mintedAt      DateTime @map("minted_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entitlement Entitlement @relation(fields: [entitlementId], references: [id])
  mintJob     MintJob     @relation(fields: [mintJobId], references: [id])

  @@unique([chainRef, contractRef, tokenRef])
  @@index([ownerRef])
  @@map("nft_tokens")
}

// ============================================================================
// イベントと監査
// ============================================================================

enum OutboxStatus {
  pending
  published
  failed
}

/// Transactional Outbox。
/// 業務データの更新と同一トランザクションでイベント行を書き、
/// 別プロセスが配信する。「支払は確定したが通知が飛ばなかった」を防ぐ。
///
/// payload に個人情報を含めない。イベントは複数の購読者・ログを経由するため。
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventName     String       @map("event_name")
  eventVersion  Int          @default(1) @map("event_version")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  status        OutboxStatus @default(pending)
  attemptCount  Int          @default(0) @map("attempt_count")

  @@index([status, occurredAt])
  @@map("outbox_events")
}

enum WalletDeliveryOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD
}

/// OVEW Wallet への配送待ち行列（PR-NW04 §10）。
///
/// ⚠️ **`outbox_events` とは別のテーブルにしてある。**
/// あちらは「業務で起きた事実」の記録で、購読者が何であっても内容は変わらない。
/// こちらは「特定の相手へ HTTP で届ける仕事」で、宛先・試行回数・
/// 打ち切りといった**配送の都合**を持つ。1 つの表に混ぜると、
/// 事実の記録が配送の再試行で書き換わる。
///
/// ⚠️ **行の作成は業務状態の変更と同一トランザクションで行う。**
/// Claim を確定してから別途 INSERT すると、その間に落ちたときに
/// 「受け取ったのに Wallet へ届かない」行が誰にも気づかれず残る。
///
/// ⚠️ **`event_id` は再試行で作り直さない。**
/// 相手の冪等キーがこの値なので、作り直すと再試行のたびに
/// 別のイベントとして扱われ、Holding が重複しうる。
model WalletDeliveryOutbox {
  id            String                     @id @default(uuid()) @db.Uuid
  /// 送信側が採番するイベントID。**相手の Idempotency-Key と同じ値**。
  /// UNIQUE が二重配送を防ぐ最後の砦（アプリの重複チェックは競合で破れる）。
  eventId       String                     @unique @map("event_id")
  eventType     String                     @map("event_type")
  entitlementId String                     @map("entitlement_id") @db.Uuid
  /// 宛先の識別子。現状は `ovew-wallet` のみ。
  targetSiteKey String                     @map("target_site_key")
  /// 送信する本文の **JSON テキストそのもの**。
  ///
  /// ⚠️ **jsonb ではなく文字列で持つ。**
  /// 署名は「送るバイト列そのもの」に対して行う（HMAC v1.1）。
  /// jsonb に入れると Postgres がキー順と空白を正規化するため、
  /// 読み戻して stringify した文字列は**入れたときと別物**になりうる。
  /// 保存・署名・送信で 3 通りの本文が生まれる余地を、型で消しておく。
  ///
  /// 送信時点のスナップショットであり、あとでマスタが変わっても
  /// 再試行の内容は変わらない（§24）。
  /// ⚠️ 個人情報を入れない。入れてよいのは `common_user_id` まで。
  payload       String
  /// 本文の内容ハッシュ（`sha256:<hex>`）。`payload` の文字列に対して計算する。
  payloadHash   String                     @map("payload_hash")
  status        WalletDeliveryOutboxStatus @default(PENDING)
  attemptCount  Int                        @default(0) @map("attempt_count")
  maxAttempts   Int                        @default(5) @map("max_attempts")
  /// バックオフ後の実行予定時刻。
  nextRetryAt   DateTime                   @default(now()) @map("next_retry_at") @db.Timestamptz(6)
  /// 失敗理由の分類コード。外部の生メッセージを入れない。
  lastErrorCode String?                    @map("last_error_code")
  /// 運用が読むための要約。⚠️ 応答本文をそのまま入れない（秘匿値が混ざりうる）。
  lastErrorMessage String?                 @map("last_error_message")
  /// Claim から配送まで同じ値を引き継ぐ（§17）。
  correlationId String                     @map("correlation_id")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveredAt   DateTime?                  @map("delivered_at") @db.Timestamptz(6)

  entitlement Entitlement @relation(fields: [entitlementId], references: [id])

  @@index([status, nextRetryAt])
  @@index([entitlementId])
  @@map("wallet_delivery_outbox")
}

/// 管理操作の監査証跡。
/// summary には業務値のみを入れ、秘匿値を含めない。
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  /// null はシステムによる自動操作。
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  summary        Json
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor Account? @relation(fields: [actorAccountId], references: [id])

  @@index([targetType, targetId, occurredAt])
  @@index([actorAccountId, occurredAt])
  @@map("audit_logs")
}

/// 冪等キー。同じ操作が 2 回実行されないようにする。
///
/// ⚠️ **保存先をプロセス内メモリにしない。**
/// メモリだと台数を増やした瞬間に効かなくなり、しかも
/// 「効いていない」ことが見た目には分からない。
/// 取り返しのつかない操作（注文・決済）を扱う前に DB へ移す。
///
/// ⚠️ **「探してから書く」のではなく「先に占有する」。**
/// 探す→無い→処理する、の順だと、同時に来た 2 本が両方とも
/// 「無い」を見て両方処理してしまう。UNIQUE 制約で先に場所を取り、
/// 取れた 1 本だけが処理する。
model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  /// キーはアクターごとに区切る。区切らないと他人のキーを当てて応答を読める。
  actorAccountId String    @map("actor_account_id") @db.Uuid
  key            String
  /// リクエスト内容のハッシュ。値そのものは保持しない。
  requestDigest  String    @map("request_digest")
  /// in_progress … 占有だけした状態 / completed … 応答を記録済み
  status         String
  statusCode     Int?      @map("status_code")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  actor Account @relation(fields: [actorAccountId], references: [id], onDelete: Cascade)

  @@unique([actorAccountId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// 署名の使い捨て値（nonce）。リプレイ攻撃を防ぐ。
///
/// ⚠️ **一意制約そのものが判定。**
/// 「探して無ければ受け付ける」だと、同時に届いた 2 本が両方通る。
/// INSERT を試みて弾かれたかどうかで、使用済みかを決める。
///
/// ⚠️ プロセス内メモリに置かない。台数を増やすと別プロセスの記録が
/// 見えず、リプレイを素通しする。しかもその事実が外からは見えない。
model HmacNonce {
  id        String   @id @default(uuid()) @db.Uuid
  keyId     String   @map("key_id")
  nonce     String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  /// この時刻を過ぎたら掃除してよい。署名の許容時間より少し先。
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([keyId, nonce])
  @@index([expiresAt])
  @@map("hmac_nonces")
}
